<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Career & Compensation Timeline | <%= employee.firstName %> <%= employee.lastName %></title>
  
  <!-- Google Fonts & Bootstrap -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0052cc;
      --primary-dark: #0747a6;
      --hrms-cobalt: #2563eb;
      --hrms-cyan: #06b6d4;
      --hrms-text-dark: #0f172a;
      --hrms-text-muted: #475569;
      --hrms-border: #dfe1e6;
      --hrms-bg-light: #f8fafc;
      --btn-gradient: linear-gradient(135deg, #2563eb 0%, #0284c7 50%, #06b6d4 100%);
    }

    body {
      background-color: var(--hrms-bg-light);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--hrms-text-dark);
      letter-spacing: -0.01em;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .navbar {
      background: #ffffff !important;
      border-bottom: 1px solid var(--hrms-border);
      padding: 0.85rem 0;
    }

    .brand-emblem {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, var(--hrms-cobalt) 0%, var(--hrms-cyan) 100%);
      border-radius: 9px;
      color: #ffffff;
      font-size: 0.95rem;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

    .page-header {
      padding: 32px 0 24px;
      border-bottom: 1px solid var(--hrms-border);
      background: #ffffff;
    }

    .glass-card {
      background: white;
      border: 1px solid var(--hrms-border);
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 2px 8px rgba(9, 30, 66, 0.04);
    }

    .avatar-box {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, #2563eb, #0284c7);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.4rem;
    }

    .timeline-node {
      position: relative;
      padding-left: 2rem;
      padding-bottom: 2rem;
      border-left: 2px solid #bfdbfe;
    }

    .timeline-node:last-child {
      border-left: 2px solid transparent;
      padding-bottom: 0;
    }

    .timeline-dot {
      position: absolute;
      left: -9px;
      top: 0;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--hrms-cobalt);
      border: 3px solid #ffffff;
      box-shadow: 0 0 0 2px #bfdbfe;
    }
  </style>
</head>
<body>
  <%- include('../partials/anti-cache') %>

  <!-- Standard App Navbar -->
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container-fluid px-4 px-lg-5">
      <a class="navbar-brand d-flex align-items-center fw-bold" href="/dashboard" style="color: var(--primary);">
        <span class="brand-emblem me-2"><i class="fa-solid fa-timeline"></i></span>
        <span>HRMS Employee Portal</span>
      </a>
      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
      </div>
    </div>
  </nav>

  <!-- Standard Page Header -->
  <div class="page-header mb-4">
    <div class="container-fluid px-4 px-lg-5">
      <div>
        <span class="badge mb-2" style="background: rgba(0, 82, 204, 0.08); color: var(--primary); border: 1px solid rgba(0, 82, 204, 0.2); font-weight: 700; font-size: 0.72rem;">
          <i class="fa-solid fa-chart-line me-1 text-primary"></i> CAREER & SALARY PROGRESSION
        </span>
        <h2 class="fw-bold mb-1" style="color: #091e42; letter-spacing: -0.02em;">Career & Compensation Timeline</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Official chronological record of salary appraisals, designation upgrades, and increment letters.</p>
      </div>
    </div>
  </div>

  <div class="container-fluid px-4 px-lg-5 pb-5">
    
    <!-- Hero Profile Card -->
    <div class="glass-card mb-4">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="avatar-box"><%= employee.firstName.charAt(0) %></div>
          <div>
            <h4 class="fw-bold mb-1 text-dark"><%= employee.firstName %> <%= employee.lastName %></h4>
            <div class="d-flex flex-wrap gap-2 text-muted small" style="font-size: 0.82rem;">
              <span><i class="fa-solid fa-id-badge text-primary me-1"></i>Code: <strong><%= employee.employeeCode %></strong></span>
              <span>&bull;</span>
              <span><i class="fa-solid fa-briefcase text-primary me-1"></i>Designation: <strong><%= employee.designation %></strong></span>
              <span>&bull;</span>
              <span><i class="fa-solid fa-building text-primary me-1"></i>Department: <%= employee.department %></span>
              <span>&bull;</span>
              <span><i class="fa-solid fa-calendar-check text-primary me-1"></i>Joined: <%= new Date(employee.joiningDate).toLocaleDateString() %></span>
            </div>
          </div>
        </div>

        <div class="text-md-end">
          <span class="text-uppercase small fw-bold text-muted d-block" style="font-size: 0.72rem;">Current Monthly Compensation</span>
          <h3 class="fw-extrabold text-primary mb-0">₹ <%= Number(employee.salary || 0).toLocaleString('en-IN') %></h3>
        </div>
      </div>
    </div>

    <!-- Timeline of Revisions -->
    <div class="glass-card">
      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-1">
            <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Appraisal & Hike History
          </h5>
          <p class="text-muted small mb-0">Milestones authorized and approved by the Human Resources Department</p>
        </div>
        <span class="badge bg-light text-primary border fw-bold px-3 py-1.5 rounded-pill">
          <%= history.length %> Milestones
        </span>
      </div>

      <% if (history.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="fa-solid fa-seedling display-4 text-secondary opacity-50 mb-3 d-block"></i>
          <p class="fw-bold mb-1">No compensation revisions recorded yet.</p>
          <span class="small">Approved appraisal cycles will automatically document here with downloadable increment letters.</span>
        </div>
      <% } else { %>
        <div class="ps-2 pt-2">
          <% history.forEach((rev) => { %>
            <div class="timeline-node">
              <div class="timeline-dot"></div>
              
              <div class="p-3 bg-white rounded-3 border shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-weight: 800;">
                      +<%= rev.hikePercentage %>% Hike
                    </span>
                    <strong class="text-dark"><%= rev.revisionType %></strong>
                  </div>
                  <span class="small text-muted">
                    <i class="fa-regular fa-calendar me-1"></i>Effective Date: <%= new Date(rev.effectiveDate).toLocaleDateString() %>
                  </span>
                </div>

                <div class="d-flex align-items-center gap-3 my-2.5 small">
                  <div>
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Previous Monthly</span>
                    <strong>₹ <%= Number(rev.previousSalary).toLocaleString('en-IN') %></strong>
                  </div>
                  <div class="text-muted"><i class="fa-solid fa-arrow-right text-primary"></i></div>
                  <div>
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Revised Monthly</span>
                    <strong class="text-primary fs-6">₹ <%= Number(rev.newSalary).toLocaleString('en-IN') %></strong>
                  </div>
                </div>

                <% if (rev.reason) { %>
                  <p class="small text-muted bg-light p-2.5 rounded-3 border mb-2 fst-italic">
                    "<%= rev.reason %>"
                  </p>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </div>

  <footer class="text-center py-4 border-top bg-white mt-auto">
    <p class="text-muted small mb-0">© 2026 HRMS • Enterprise Employee Compensation Portal</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
