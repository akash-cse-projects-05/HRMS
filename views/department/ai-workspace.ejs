<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= department %> AI Co-pilot | HRMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #f0f4ff;
      --card: #ffffff;
      --primary: #2563eb;
      --primary-light: #eff6ff;
      --primary-dark: #1d4ed8;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --bubble-user: #2563eb;
      --bubble-ai: #f8fafc;
      --radius: 18px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ── Top Bar ── */
    .topbar {
      background: #0f172a;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      border-bottom: 1px solid #1e293b;
    }

    .topbar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1rem;
    }

    .brand-title {
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
    }

    .brand-sub {
      font-size: 0.72rem;
      color: #94a3b8;
      margin-top: 1px;
    }

    .topbar-actions {
      display: flex;
      gap: 8px;
    }

    .btn-back {
      background: rgba(255,255,255,0.07);
      border: 1px solid #334155;
      color: #cbd5e1;
      padding: 7px 16px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-back:hover { background: rgba(255,255,255,0.13); }

    /* ── Status bar ── */
    .status-bar {
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 8px 24px;
      font-size: 0.78rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 20px;
      flex-shrink: 0;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* ── Suggested Questions ── */
    .suggestions-bar {
      background: var(--primary-light);
      border-bottom: 1px solid #bfdbfe;
      padding: 10px 24px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .suggestion-chip {
      background: #fff;
      border: 1px solid #bfdbfe;
      color: var(--primary);
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .suggestion-chip:hover {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    /* ── Chat Area ── */
    .chat-area {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      scroll-behavior: smooth;
    }

    /* ── Messages ── */
    .message {
      display: flex;
      gap: 10px;
      animation: fadeIn 0.25s ease;
      max-width: 75%;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .message.user { align-self: flex-end; flex-direction: row-reverse; }
    .message.ai   { align-self: flex-start; }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .avatar.ai-avatar {
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      color: #fff;
    }

    .avatar.user-avatar {
      background: #e2e8f0;
      color: #475569;
    }

    .bubble {
      padding: 12px 16px;
      border-radius: var(--radius);
      font-size: 0.88rem;
      line-height: 1.65;
      max-width: 100%;
    }

    .message.user .bubble {
      background: var(--bubble-user);
      color: #fff;
      border-bottom-right-radius: 4px;
    }

    .message.ai .bubble {
      background: var(--bubble-ai);
      color: var(--text);
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
    }

    .bubble .meta {
      font-size: 0.68rem;
      opacity: 0.55;
      margin-top: 4px;
    }

    /* Typing indicator */
    .typing-dots {
      display: flex;
      gap: 4px;
      align-items: center;
      padding: 6px 0;
    }

    .typing-dots span {
      width: 7px; height: 7px;
      background: #94a3b8;
      border-radius: 50%;
      animation: bounce 1.2s infinite;
    }

    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

    @keyframes bounce {
      0%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-6px); }
    }

    /* Welcome card */
    .welcome-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      text-align: center;
      align-self: center;
      max-width: 480px;
    }

    .welcome-card .icon {
      width: 56px;
      height: 56px;
      background: linear-gradient(135deg, #2563eb22, #7c3aed22);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin: 0 auto 16px;
      color: #2563eb;
    }

    /* ── Input Bar ── */
    .input-bar {
      flex-shrink: 0;
      background: #fff;
      border-top: 1px solid var(--border);
      padding: 16px 24px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      align-items: flex-end;
    }

    #questionInput {
      flex: 1;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 0.9rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
      resize: none;
      outline: none;
      transition: border-color 0.2s;
      max-height: 120px;
      line-height: 1.5;
    }

    #questionInput:focus { border-color: var(--primary); }

    #sendBtn {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: var(--primary);
      border: none;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    #sendBtn:hover { background: var(--primary-dark); }
    #sendBtn:active { transform: scale(0.95); }
    #sendBtn:disabled { background: #94a3b8; cursor: not-allowed; }

    .input-hint {
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 6px;
    }
  </style>
</head>
<body>

  <!-- Top Bar -->
  <header class="topbar">
    <div class="topbar-brand">
      <div class="brand-icon"><i class="fa-solid fa-microchip"></i></div>
      <div>
        <div class="brand-title"><%= department %> Department AI Co-pilot</div>
        <div class="brand-sub">Ask anything about HR, leaves, payroll, attendance, or team management</div>
      </div>
    </div>
    <div class="topbar-actions">
      <a href="/department/<%= department %>" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Department</a>
      <a href="/hr/dashboard" class="btn-back"><i class="fa-solid fa-house"></i> HR Dashboard</a>
    </div>
  </header>

  <!-- Status Bar -->
  <div class="status-bar">
    <span><span class="status-dot"></span> &nbsp;Co-pilot Online &mdash; <strong><%= department %></strong></span>
    <span><i class="fa-solid fa-users fa-xs me-1"></i> <%= employees.length %> active employee<%= employees.length !== 1 ? 's' : '' %> in department</span>
  </div>

  <!-- Chat Area -->
  <div class="chat-area" id="chatArea">

    <!-- Welcome card (shown initially) -->
    <div class="welcome-card" id="welcomeCard">
      <div class="icon"><i class="fa-solid fa-comments"></i></div>
      <h2 style="font-size:1.1rem; font-weight:800; margin-bottom:8px;">Hi! I'm your <%= department %> AI Co-pilot</h2>
      <p style="font-size:0.85rem; color:#64748b; line-height:1.6;">
        Ask me anything about HR policies, leave rules, attendance, payroll, expenses, or team queries.
        I'm here to give you quick, friendly answers.
      </p>
    </div>

  </div>

  <!-- Input Bar -->
  <div class="input-bar">
    <div class="input-row">
      <textarea id="questionInput" placeholder="Ask your question... (e.g. How many sick leaves do I have?)" rows="1"
        onkeydown="handleEnter(event)" oninput="autoGrow(this)"></textarea>
      <button id="sendBtn" onclick="sendQuestion()" title="Send">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </div>
    <div class="input-hint"><i class="fa-solid fa-circle-info fa-xs"></i> Press Enter to send &middot; Shift+Enter for new line</div>
  </div>

  <script>
    const DEPARTMENT = "<%= department %>";
    let history = [];
    let isLoading = false;

    function now() {
      return new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
    }

    function autoGrow(el) {
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 120) + 'px';
    }

    function handleEnter(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendQuestion();
      }
    }

    function askSuggestion(q) {
      document.getElementById('questionInput').value = q;
      sendQuestion();
    }

    function appendMessage(role, text) {
      const welcomeCard = document.getElementById('welcomeCard');
      if (welcomeCard) welcomeCard.remove();

      const chatArea = document.getElementById('chatArea');
      const isUser = role === 'user';

      const wrapper = document.createElement('div');
      wrapper.className = `message ${isUser ? 'user' : 'ai'}`;

      const avatar = document.createElement('div');
      avatar.className = `avatar ${isUser ? 'user-avatar' : 'ai-avatar'}`;
      avatar.innerHTML = isUser
        ? '<i class="fa-solid fa-user"></i>'
        : '<i class="fa-solid fa-microchip"></i>';

      const bubble = document.createElement('div');
      bubble.className = 'bubble';

      // Simple markdown-like: bold **text**, newlines as <br>
      const formatted = text
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');

      bubble.innerHTML = `${formatted}<div class="meta">${now()}</div>`;

      wrapper.appendChild(avatar);
      wrapper.appendChild(bubble);
      chatArea.appendChild(wrapper);
      chatArea.scrollTop = chatArea.scrollHeight;

      return wrapper;
    }

    function showTyping() {
      const welcomeCard = document.getElementById('welcomeCard');
      if (welcomeCard) welcomeCard.remove();

      const chatArea = document.getElementById('chatArea');
      const wrapper = document.createElement('div');
      wrapper.className = 'message ai';
      wrapper.id = 'typingIndicator';

      wrapper.innerHTML = `
        <div class="avatar ai-avatar"><i class="fa-solid fa-microchip"></i></div>
        <div class="bubble" style="padding: 14px 18px;">
          <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>`;

      chatArea.appendChild(wrapper);
      chatArea.scrollTop = chatArea.scrollHeight;
    }

    function removeTyping() {
      const el = document.getElementById('typingIndicator');
      if (el) el.remove();
    }

    async function sendQuestion() {
      if (isLoading) return;
      const input = document.getElementById('questionInput');
      const question = input.value.trim();
      if (!question) return;

      input.value = '';
      input.style.height = 'auto';

      appendMessage('user', question);
      showTyping();
      isLoading = true;
      document.getElementById('sendBtn').disabled = true;

      try {
        const res = await fetch('/department/ai-workspace/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question,
            department: DEPARTMENT,
            history: history.slice(-6)
          })
        });

        const data = await res.json();
        removeTyping();

        if (res.ok && data.answer) {
          appendMessage('ai', data.answer);
          // Update history
          history.push({ role: 'user', content: question });
          history.push({ role: 'assistant', content: data.answer });
        } else {
          appendMessage('ai', '⚠️ ' + (data.error || 'Something went wrong. Please try again.'));
        }

      } catch (err) {
        removeTyping();
        appendMessage('ai', '⚠️ Could not reach the AI service. Make sure the Python service is running.');
      }

      isLoading = false;
      document.getElementById('sendBtn').disabled = false;
      document.getElementById('questionInput').focus();
    }
  </script>

</body>
</html>
