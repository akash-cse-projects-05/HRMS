<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Trips & Field Mobility | HRMS</title>

  <!-- Google Fonts & Bootstrap -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --hrms-blue-dark: #050c1e;
      --hrms-blue-glow: #020612;
      --hrms-electric: #38bdf8;
      --hrms-cyan: #06b6d4;
      --hrms-cobalt: #2563eb;
      --hrms-text-dark: #0f172a;
      --hrms-text-muted: #475569;
      --hrms-border: rgba(15, 23, 42, 0.08);
      --hrms-bg-light: #f8fafc;
      --btn-gradient: linear-gradient(135deg, #2563eb 0%, #0284c7 50%, #06b6d4 100%);
      --btn-gradient-hover: linear-gradient(135deg, #1d4ed8 0%, #0369a1 50%, #0891b2 100%);
    }

    body {
      background-color: var(--hrms-bg-light);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--hrms-text-dark);
      letter-spacing: -0.015em;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* --- BRANDING NAVBAR --- */
    .navbar-landing {
      background: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--hrms-border);
      padding: 0.75rem 2rem;
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    .brand-emblem {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, var(--hrms-cobalt) 0%, var(--hrms-cyan) 100%);
      border-radius: 9px;
      color: #ffffff;
      font-size: 0.95rem;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

    .brand-emblem i.fa-circle-nodes {
      font-size: 0.55rem;
      position: absolute;
      bottom: 4px;
      right: 4px;
      color: var(--hrms-electric);
      background: var(--hrms-blue-dark);
      border-radius: 50%;
      padding: 1px;
    }

    .navbar-brand {
      font-weight: 800;
      color: var(--hrms-blue-dark) !important;
      letter-spacing: -0.04em;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1.25rem;
      text-decoration: none;
    }

    .brand-accent {
      background: linear-gradient(to right, var(--hrms-cobalt), var(--hrms-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* --- PAGE HEADER --- */
    .page-header {
      background: linear-gradient(135deg, #050c1e 0%, #0a192f 50%, #0d234a 100%);
      color: white;
      padding: 42px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
      overflow: hidden;
    }

    .page-header::before {
      content: "";
      position: absolute;
      top: -30%;
      right: -10%;
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--hrms-electric);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.85rem;
    }

    /* --- KPI STATS --- */
    .kpi-card {
      background: #ffffff;
      border: 1px solid var(--hrms-border);
      border-radius: 16px;
      padding: 22px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
      height: 100%;
    }

    .kpi-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.07);
      border-color: rgba(37, 99, 235, 0.2);
    }

    .kpi-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      background: rgba(37, 99, 235, 0.08);
      color: var(--hrms-cobalt);
    }

    /* --- ITINERARY TRIP CARD --- */
    .trip-dossier {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
      position: relative;
    }

    .trip-dossier:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(37, 99, 235, 0.09);
      border-color: rgba(37, 99, 235, 0.3);
    }

    .dossier-top {
      padding: 1.25rem 1.4rem;
      background: #fafcff;
      border-bottom: 1px solid #edf2f7;
    }

    .dossier-body {
      padding: 1.4rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .dossier-footer {
      padding: 1.1rem 1.4rem;
      background: #f8fafc;
      border-top: 1px solid #edf2f7;
    }

    /* Flight / Route Visual Strip */
    .route-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      margin-bottom: 1rem;
    }

    .route-city {
      max-width: 42%;
    }

    .route-line {
      flex-grow: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .route-line::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: #cbd5e1;
    }

    .route-line i {
      position: relative;
      background: #ffffff;
      padding: 0 6px;
      color: var(--hrms-cobalt);
      font-size: 0.85rem;
    }

    /* Status Pills */
    .status-badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.35rem 0.85rem;
      border-radius: 99px;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      letter-spacing: 0.02em;
    }

    .status-in-progress {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }

    .status-approved {
      background: #f0fdf4;
      color: #15803d;
      border: 1px solid #bbf7d0;
    }

    .status-completed {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }

    .status-pending {
      background: #fefce8;
      color: #854d0e;
      border: 1px solid #fef08a;
    }

    .status-rejected {
      background: #fff1f2;
      color: #be123c;
      border: 1px solid #fecdd3;
    }

    /* Pulse */
    .pulse-dot {
      width: 7px;
      height: 7px;
      background-color: #2563eb;
      border-radius: 50%;
      animation: pulse-ring 1.8s infinite;
    }

    @keyframes pulse-ring {
      0% {
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7);
      }
      70% {
        box-shadow: 0 0 0 8px rgba(37, 99, 235, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
      }
    }

    /* Nav Pills */
    .nav-pills-hrms .nav-link {
      color: #64748b;
      font-weight: 600;
      font-size: 0.875rem;
      padding: 0.5rem 1.15rem;
      border-radius: 99px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      transition: all 0.2s ease;
    }

    .nav-pills-hrms .nav-link:hover {
      color: var(--hrms-cobalt);
      border-color: var(--hrms-cobalt);
    }

    .nav-pills-hrms .nav-link.active {
      background: var(--hrms-cobalt);
      color: #ffffff;
      border-color: var(--hrms-cobalt);
    }

    .btn-gradient {
      background: var(--btn-gradient);
      color: white;
      border: none;
      font-weight: 700;
      transition: all 0.2s ease;
    }

    .btn-gradient:hover {
      background: var(--btn-gradient-hover);
      color: white;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
      transform: translateY(-1px);
    }
  </style>
</head>

<body>
  <%- include('../partials/anti-cache') %>

  <!-- Top Navigation -->
  <nav class="navbar navbar-expand-lg navbar-landing">
    <div class="container">
      <a class="navbar-brand" href="/dashboard">
        <div class="brand-emblem">
          <i class="fa-solid fa-shield-halved"></i>
          <i class="fa-solid fa-circle-nodes"></i>
        </div>
        <span><span class="brand-accent">H</span>RMS</span>
      </a>

      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/trip/request" class="btn btn-gradient btn-sm rounded-pill px-3 shadow-sm">
          <i class="fa-solid fa-plus me-1"></i> Request Trip
        </a>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
          <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
        <% if (typeof employee !== 'undefined' && employee) { %>
          <div class="ms-2 ps-2 border-start d-none d-md-flex align-items-center text-muted small">
            <i class="fa-solid fa-circle-user me-1 text-primary"></i>
            <span class="fw-semibold text-dark"><%= employee.firstName %> <%= employee.lastName %></span>
          </div>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8">
          <span class="header-badge">
            <i class="fa-solid fa-map-location-dot"></i> Corporate Mobility Desk
          </span>
          <h1 class="fw-bold mb-2 text-white">My Trips & Travel Records</h1>
          <p class="text-white-50 mb-0 fs-6">
            Review authorized business journeys, initiate GPS audit tracking, and access historical travel logs.
          </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
          <a href="/trip/request" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm fw-bold">
            <i class="fa-solid fa-circle-plus me-2"></i>Request New Trip
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container py-4 flex-grow-1">

    <!-- KPI Summary Row -->
    <% 
      const totalTrips = trips.length;
      const inProgressTrips = trips.filter(t => t.status === 'In Progress').length;
      const approvedTrips = trips.filter(t => t.status === 'Approved').length;
      const completedTrips = trips.filter(t => t.status === 'Completed').length;
      const pendingTrips = trips.filter(t => t.status === 'Pending').length;
    %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon">
            <i class="fa-solid fa-suitcase-rolling"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Journeys</div>
            <div class="fs-4 fw-bold text-dark"><%= totalTrips %></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
            <i class="fa-solid fa-satellite-dish"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Active In-Field</div>
            <div class="fs-4 fw-bold text-primary"><%= inProgressTrips %></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon" style="background: rgba(21, 128, 61, 0.1); color: #15803d;">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Approved Ready</div>
            <div class="fs-4 fw-bold" style="color: #15803d;"><%= approvedTrips %></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon" style="background: rgba(71, 85, 105, 0.1); color: #475569;">
            <i class="fa-solid fa-flag-checkered"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Completed</div>
            <div class="fs-4 fw-bold text-secondary"><%= completedTrips %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Pills & Search -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <ul class="nav nav-pills nav-pills-hrms gap-2 mb-0" id="tripFilterTabs">
          <li class="nav-item">
            <button class="nav-link active" onclick="filterTrips('all')">All Trips (<%= totalTrips %>)</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" onclick="filterTrips('In Progress')">
              In Progress (<%= inProgressTrips %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" onclick="filterTrips('Approved')">
              Approved (<%= approvedTrips %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" onclick="filterTrips('Completed')">
              Completed (<%= completedTrips %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" onclick="filterTrips('Pending')">
              Pending (<%= pendingTrips %>)
            </button>
          </li>
        </ul>

        <div class="input-group" style="max-width: 300px;">
          <span class="input-group-text bg-light border-end-0 text-muted">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input type="text" id="tripSearchInput" class="form-control bg-light border-start-0" placeholder="Search destination / purpose..." onkeyup="searchTrips()">
        </div>
      </div>
    </div>

    <!-- Trip Dossiers Grid -->
    <% if (trips.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
        <div class="w-16 h-16 rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-4 mb-3 text-primary">
          <i class="fa-solid fa-map-location-dot fa-3x"></i>
        </div>
        <h4 class="fw-bold text-dark mb-1">No Travel History Found</h4>
        <p class="text-muted small mb-4" style="max-width: 440px; margin: 0 auto;">
          You currently have no registered travel or client visits. Submit a formal trip requisition to get started.
        </p>
        <a href="/trip/request" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
          <i class="fa-solid fa-plus me-2"></i>Request Your First Trip
        </a>
      </div>
    <% } else { %>
      <div class="row g-4" id="tripsContainer">
        <% trips.forEach(trip => { %>
          <% 
            const sDate = new Date(trip.startDate);
            const eDate = new Date(trip.endDate);
            const daysCount = Math.max(1, Math.ceil((eDate - sDate) / (1000 * 60 * 60 * 24)) + 1);
          %>
          <div class="col-md-6 col-lg-4 trip-item" data-status="<%= trip.status %>" data-search="<%= (trip.destination + ' ' + (trip.source || '') + ' ' + trip.purpose).toLowerCase() %>">
            <div class="trip-dossier">

              <!-- Dossier Top: Destination & Status -->
              <div class="dossier-top d-flex justify-content-between align-items-center">
                <div>
                  <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Destination</span>
                  <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 180px;" title="<%= trip.destination %>">
                    <%= trip.destination %>
                  </h6>
                </div>
                <div>
                  <% if (trip.status === 'In Progress') { %>
                    <span class="status-badge status-in-progress">
                      <span class="pulse-dot"></span> In Progress
                    </span>
                  <% } else if (trip.status === 'Approved') { %>
                    <span class="status-badge status-approved">
                      <i class="fa-solid fa-circle-check"></i> Approved
                    </span>
                  <% } else if (trip.status === 'Completed') { %>
                    <span class="status-badge status-completed">
                      <i class="fa-solid fa-flag-checkered"></i> Completed
                    </span>
                  <% } else if (trip.status === 'Pending') { %>
                    <span class="status-badge status-pending">
                      <i class="fa-solid fa-clock"></i> Pending
                    </span>
                  <% } else { %>
                    <span class="status-badge status-rejected">
                      <i class="fa-solid fa-ban"></i> Rejected
                    </span>
                  <% } %>
                </div>
              </div>

              <!-- Dossier Body: Route Strip, Dates, Purpose -->
              <div class="dossier-body">

                <!-- Route Strip -->
                <div class="route-strip">
                  <div class="route-city">
                    <span class="text-muted small d-block">Origin</span>
                    <strong class="text-dark small text-truncate d-block" title="<%= trip.source || 'Headquarters' %>">
                      <%= trip.source || 'Headquarters' %>
                    </strong>
                  </div>
                  <div class="route-line">
                    <i class="fa-solid fa-plane"></i>
                  </div>
                  <div class="route-city text-end">
                    <span class="text-muted small d-block">Target</span>
                    <strong class="text-primary small text-truncate d-block" title="<%= trip.destination %>">
                      <%= trip.destination.split(',')[0] %>
                    </strong>
                  </div>
                </div>

                <!-- Schedule Duration -->
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border small text-muted mb-3">
                  <div>
                    <i class="fa-regular fa-calendar-days text-primary me-1"></i>
                    <span><%= sDate.toLocaleDateString() %></span>
                  </div>
                  <span class="badge bg-white text-dark border px-2 py-1 font-monospace">
                    <%= daysCount %> <%= daysCount === 1 ? 'Day' : 'Days' %>
                  </span>
                  <div>
                    <i class="fa-regular fa-calendar-check text-success me-1"></i>
                    <span><%= eDate.toLocaleDateString() %></span>
                  </div>
                </div>

                <!-- Purpose & Description -->
                <div class="p-2.5 rounded-3 bg-light border mb-2 flex-grow-1">
                  <span class="text-primary fw-bold small text-uppercase d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.04em;">
                    <i class="fa-solid fa-file-lines me-1"></i> Purpose & Itinerary Agenda:
                  </span>
                  <p class="text-dark small mb-0 fw-medium" style="line-height: 1.45; word-break: break-word;">
                    <%= trip.purpose %>
                  </p>
                </div>

                <% if (trip.status === 'Rejected' && trip.rejectionReason) { %>
                  <div class="p-2 rounded-3 bg-danger-subtle text-danger small mt-2">
                    <strong class="d-block mb-1"><i class="fa-solid fa-circle-exclamation me-1"></i>Rejection Explanation:</strong>
                    <%= trip.rejectionReason %>
                  </div>
                <% } %>
              </div>

              <!-- Dossier Footer Action Buttons -->
              <div class="dossier-footer">
                <% if (trip.status === 'Approved') { %>
                  <button class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm" onclick="startTrip('<%= trip._id %>')">
                    <i class="fa-solid fa-play me-2"></i> Start Trip & Enable GPS
                  </button>
                <% } else if (trip.status === 'In Progress') { %>
                  <div class="d-grid gap-2">
                    <a href="/trip/monitor/<%= trip._id %>" class="btn btn-primary fw-bold rounded-pill shadow-sm">
                      <i class="fa-solid fa-satellite-dish me-2"></i> Live Field Monitor
                    </a>
                    <div class="d-flex gap-2">
                      <form action="/trip/end/<%= trip._id %>" method="POST" class="flex-grow-1" onsubmit="return confirm('Conclude this journey and stop live GPS tracking?');">
                        <button type="submit" class="btn btn-outline-dark btn-sm w-100 rounded-pill fw-semibold">
                          <i class="fa-solid fa-flag-checkered me-1"></i> End Trip
                        </button>
                      </form>
                      <a href="/trip/track/<%= trip._id %>" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold px-3">
                        <i class="fa-solid fa-file-pen me-1"></i> Logs
                      </a>
                    </div>
                  </div>
                <% } else if (trip.status === 'Completed') { %>
                  <a href="/trip/track/<%= trip._id %>" class="btn btn-outline-primary w-100 fw-semibold rounded-pill">
                    <i class="fa-solid fa-file-invoice me-2"></i> View Audit & Expense Logs
                  </a>
                <% } else if (trip.status === 'Pending') { %>
                  <button class="btn btn-light border text-muted w-100 small rounded-pill" disabled>
                    <i class="fa-solid fa-clock me-1"></i> Awaiting Manager Approval
                  </button>
                <% } else { %>
                  <a href="/trip/request" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                    <i class="fa-solid fa-rotate-left me-1"></i> Re-submit Request
                  </a>
                <% } %>
              </div>

            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    function startTrip(tripId) {
      if (!confirm("Are you ready to initiate this trip? Location tracking will begin.")) return;

      if (!navigator.geolocation) {
        alert("Geolocation is not supported by your browser");
        return;
      }

      navigator.geolocation.getCurrentPosition(position => {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;

        fetch('/trip/start/' + tripId, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ lat, lng })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            window.location.href = '/trip/monitor/' + tripId;
          } else {
            alert(data.error || "Error starting trip");
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert("Network error occurred while contacting the server.");
        });

      }, error => {
        console.error("Geo Error:", error);
        alert("Unable to retrieve your current location. Please grant GPS access in your browser settings.");
      }, { enableHighAccuracy: true });
    }

    function filterTrips(status) {
      const tabs = document.querySelectorAll('#tripFilterTabs .nav-link');
      tabs.forEach(t => t.classList.remove('active'));
      event.target.classList.add('active');

      const items = document.querySelectorAll('.trip-item');
      items.forEach(item => {
        if (status === 'all' || item.getAttribute('data-status') === status) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    }

    function searchTrips() {
      const q = document.getElementById('tripSearchInput').value.toLowerCase().trim();
      const items = document.querySelectorAll('.trip-item');
      items.forEach(item => {
        const searchData = item.getAttribute('data-search');
        if (!q || searchData.includes(q)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    }
  </script>
</body>

</html>