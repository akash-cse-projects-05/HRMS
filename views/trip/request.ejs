<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Request Business Trip | HRMS</title>

  <!-- Google Fonts & Bootstrap -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <!-- MapLibre GL CSS -->
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

  <style>
    :root {
      --hrms-blue-dark: #050c1e;
      --hrms-blue-glow: #020612;
      --hrms-electric: #38bdf8;
      --hrms-cyan: #06b6d4;
      --hrms-cobalt: #2563eb;
      --hrms-text-dark: #0f172a;
      --hrms-text-muted: #475569;
      --hrms-border: rgba(15, 23, 42, 0.08);
      --hrms-bg-light: #f8fafc;
      --btn-gradient: linear-gradient(135deg, #2563eb 0%, #0284c7 50%, #06b6d4 100%);
      --btn-gradient-hover: linear-gradient(135deg, #1d4ed8 0%, #0369a1 50%, #0891b2 100%);
    }

    body {
      background-color: var(--hrms-bg-light);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--hrms-text-dark);
      letter-spacing: -0.015em;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* --- BRANDING NAVBAR --- */
    .navbar-landing {
      background: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--hrms-border);
      padding: 0.75rem 2rem;
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    .brand-emblem {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, var(--hrms-cobalt) 0%, var(--hrms-cyan) 100%);
      border-radius: 9px;
      color: #ffffff;
      font-size: 0.95rem;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

    .brand-emblem i.fa-circle-nodes {
      font-size: 0.55rem;
      position: absolute;
      bottom: 4px;
      right: 4px;
      color: var(--hrms-electric);
      background: var(--hrms-blue-dark);
      border-radius: 50%;
      padding: 1px;
    }

    .navbar-brand {
      font-weight: 800;
      color: var(--hrms-blue-dark) !important;
      letter-spacing: -0.04em;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1.25rem;
      text-decoration: none;
    }

    .brand-accent {
      background: linear-gradient(to right, var(--hrms-cobalt), var(--hrms-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* --- PAGE HEADER --- */
    .page-header {
      background: linear-gradient(135deg, #050c1e 0%, #0a192f 50%, #0d234a 100%);
      color: white;
      padding: 38px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
      overflow: hidden;
    }

    .page-header::before {
      content: "";
      position: absolute;
      top: -30%;
      right: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--hrms-electric);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    /* --- CARDS & FORMS --- */
    .form-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 2rem;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }

    .map-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .map-container {
      height: 400px;
      width: 100%;
      border-radius: 14px;
      border: 1px solid #cbd5e1;
      overflow: hidden;
      position: relative;
    }

    .section-label {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--hrms-cobalt);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 1rem;
    }

    .form-control, .form-select {
      border-color: #cbd5e1;
      border-radius: 10px;
      padding: 0.65rem 0.9rem;
      font-size: 0.925rem;
      transition: all 0.2s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--hrms-cobalt);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .form-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 0.4rem;
    }

    .duration-banner {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .city-chip {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.25rem 0.65rem;
      background: #f1f5f9;
      color: #475569;
      border-radius: 99px;
      cursor: pointer;
      transition: all 0.15s ease;
      border: 1px solid #e2e8f0;
      user-select: none;
    }

    .city-chip:hover {
      background: #e0e7ff;
      color: #3730a3;
      border-color: #c7d2fe;
    }

    .btn-gradient {
      background: var(--btn-gradient);
      color: white;
      border: none;
      font-weight: 700;
      transition: all 0.2s ease;
    }

    .btn-gradient:hover {
      background: var(--btn-gradient-hover);
      color: white;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
      transform: translateY(-1px);
    }
  </style>
</head>

<body>
  <%- include('../partials/anti-cache') %>

  <!-- Top Navigation -->
  <nav class="navbar navbar-expand-lg navbar-landing">
    <div class="container">
      <a class="navbar-brand" href="/dashboard">
        <div class="brand-emblem">
          <i class="fa-solid fa-shield-halved"></i>
          <i class="fa-solid fa-circle-nodes"></i>
        </div>
        <span><span class="brand-accent">H</span>RMS</span>
      </a>

      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/trip/my-trips" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
          <i class="fa-solid fa-suitcase-rolling me-1"></i> My Trips
        </a>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
          <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8">
          <span class="header-badge">
            <i class="fa-solid fa-plane-departure"></i> Travel & Field Requisition
          </span>
          <h1 class="fw-bold mb-2 text-white">New Business Trip Request</h1>
          <p class="text-white-50 mb-0 fs-6">
            Submit business travel details, specify target client sites with 3D GPS pinning, and calculate durations for managerial audit approval.
          </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
          <a href="/trip/my-trips" class="btn btn-outline-light rounded-pill px-4 shadow-sm fw-semibold">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to My Trips
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container py-4 flex-grow-1">
    <form action="/trip/request" method="POST" id="tripForm">
      <div class="row g-4">

        <!-- Form Column -->
        <div class="col-lg-6">
          <div class="form-card">

            <!-- Section 1: Route & Destination -->
            <div class="section-label">
              <i class="fa-solid fa-map-pin"></i> 1. Route & Destination Details
            </div>

            <div class="mb-3">
              <label class="form-label">Destination Location / Client Office</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-primary border-end-0">
                  <i class="fa-solid fa-location-dot"></i>
                </span>
                <input type="text" name="destination" id="destinationInput" class="form-control border-start-0"
                  placeholder="e.g. Bandra Kurla Complex, Mumbai" required
                  oninput="searchLocation(this.value)">
              </div>
              <div class="d-flex flex-wrap gap-1 mt-2">
                <span class="text-muted small me-1">Quick Select:</span>
                <span class="city-chip" onclick="quickSelect('Mumbai Tech Center, Maharashtra')">Mumbai</span>
                <span class="city-chip" onclick="quickSelect('Electronic City, Bengaluru, Karnataka')">Bengaluru</span>
                <span class="city-chip" onclick="quickSelect('Connaught Place, New Delhi')">New Delhi</span>
                <span class="city-chip" onclick="quickSelect('HITEC City, Hyderabad, Telangana')">Hyderabad</span>
                <span class="city-chip" onclick="quickSelect('Pune IT Park, Maharashtra')">Pune</span>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label">Origin / Departure Point</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                  <i class="fa-solid fa-house-laptop"></i>
                </span>
                <input type="text" name="source" class="form-control border-start-0"
                  placeholder="e.g. Headquarters / Residence" required value="Headquarters Office">
              </div>
            </div>

            <hr class="my-4 text-muted opacity-25">

            <!-- Section 2: Schedule & Timeline -->
            <div class="section-label">
              <i class="fa-solid fa-calendar-days"></i> 2. Travel Itinerary & Timeline
            </div>

            <div class="row g-3 mb-3">
              <div class="col-sm-6">
                <label class="form-label">Departure Date</label>
                <input type="date" name="startDate" id="startDate" class="form-control" required onchange="calcDuration()">
              </div>
              <div class="col-sm-6">
                <label class="form-label">Return Date</label>
                <input type="date" name="endDate" id="endDate" class="form-control" required onchange="calcDuration()">
              </div>
            </div>

            <div class="duration-banner mb-4" id="durationBanner">
              <div class="rounded-circle bg-white p-2 text-primary shadow-sm">
                <i class="fa-solid fa-clock-rotate-left fs-5"></i>
              </div>
              <div>
                <div class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Estimated Duration</div>
                <div class="fs-5 fw-bold text-primary" id="durationText">1 Day Journey</div>
              </div>
            </div>

            <hr class="my-4 text-muted opacity-25">

            <!-- Section 3: Purpose & Scope -->
            <div class="section-label">
              <i class="fa-solid fa-clipboard-list"></i> 3. Business Purpose & Scope
            </div>

            <div class="mb-4">
              <label class="form-label">Purpose of Travel / Onsite Agenda</label>
              <textarea name="purpose" class="form-control" rows="3"
                placeholder="Provide a concise summary of the client meetings, site inspection, technical rollout, or compliance audit..." required></textarea>
            </div>

            <!-- Submit CTA -->
            <button type="submit" class="btn btn-gradient w-100 py-3 rounded-pill fw-bold shadow-sm">
              <i class="fa-solid fa-paper-plane me-2"></i> Submit Travel Requisition
            </button>

          </div>
        </div>

        <!-- Interactive Map Column -->
        <div class="col-lg-6">
          <div class="map-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-satellite text-primary me-2"></i>Location Audit Geofence</h5>
                <small class="text-muted">Drag marker or click anywhere to pin exact target coordinates</small>
              </div>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                <i class="fa-solid fa-cube me-1"></i> 3D OpenStreetMap
              </span>
            </div>

            <div id="map" class="map-container mb-3 flex-grow-1"></div>

            <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <small class="text-muted d-block fw-semibold">Audit Coordinates (Automatic)</small>
                <span class="badge bg-white text-dark border font-monospace" id="coordBadge">Lat: 20.5937, Lng: 78.9629</span>
              </div>
              <small class="text-muted fst-italic">
                <i class="fa-solid fa-circle-info me-1 text-primary"></i>Required for mobile GPS check-in verification
              </small>
            </div>

            <input type="hidden" name="destLat" id="destLat" value="20.5937">
            <input type="hidden" name="destLng" id="destLng" value="78.9629">
          </div>
        </div>

      </div>
    </form>
  </main>

  <!-- MapLibre GL JS -->
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

  <script>
    // Set default dates: Today and Tomorrow
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('startDate').value = today;
    document.getElementById('endDate').value = today;

    // Initialize MapLibre GL 3D Map
    const map = new maplibregl.Map({
      container: 'map',
      style: 'https://tiles.openfreemap.org/styles/bright',
      center: [78.9629, 20.5937],
      zoom: 5,
      pitch: 45,
      bearing: -10,
      attributionControl: false
    });

    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
    map.addControl(new maplibregl.AttributionControl({
      compact: true,
      customAttribution: '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a>'
    }), 'bottom-right');

    let marker = new maplibregl.Marker({ draggable: true, color: '#0052cc' })
      .setLngLat([78.9629, 20.5937])
      .addTo(map);

    function updateCoords(lat, lng) {
      const fixedLat = parseFloat(lat).toFixed(4);
      const fixedLng = parseFloat(lng).toFixed(4);
      document.getElementById('destLat').value = lat;
      document.getElementById('destLng').value = lng;
      document.getElementById('coordBadge').innerText = `Lat: ${fixedLat}, Lng: ${fixedLng}`;
    }

    marker.on('dragend', function () {
      const p = marker.getLngLat();
      updateCoords(p.lat, p.lng);
    });

    map.on('click', function (e) {
      marker.setLngLat([e.lngLat.lng, e.lngLat.lat]);
      updateCoords(e.lngLat.lat, e.lngLat.lng);
    });

    // Search debounce with OpenStreetMap Nominatim
    let searchTimeout = null;
    function searchLocation(query) {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(async () => {
        if (!query || query.length < 3) return;
        try {
          const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
          const data = await res.json();
          if (data && data.length > 0) {
            const lat = parseFloat(data[0].lat);
            const lng = parseFloat(data[0].lon);
            map.flyTo({ center: [lng, lat], zoom: 14, pitch: 45, essential: true });
            marker.setLngLat([lng, lat]);
            updateCoords(lat, lng);
          }
        } catch (e) {
          console.error("Search failed", e);
        }
      }, 700);
    }

    function quickSelect(cityStr) {
      document.getElementById('destinationInput').value = cityStr;
      searchLocation(cityStr);
    }

    function calcDuration() {
      const start = document.getElementById('startDate').value;
      const end = document.getElementById('endDate').value;
      if (start && end) {
        const s = new Date(start);
        const e = new Date(end);
        const diffTime = e - s;
        if (diffTime < 0) {
          document.getElementById('durationText').innerHTML = "<span class='text-danger'>End date cannot precede start date</span>";
          return;
        }
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
        document.getElementById('durationText').innerHTML = diffDays + (diffDays === 1 ? " Day Journey" : " Days Journey");
      }
    }

    // Run initial calc
    calcDuration();
  </script>
</body>

</html>