<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Assessment Portal — <%= candidate.candidateName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/exam-portal.css">
</head>
<body class="exam-body">
  <!-- Top Navigation Bar -->
  <header class="exam-header">
    <div class="header-left">
      <div class="logo-mark"><i class="fa-solid fa-robot"></i></div>
      <div>
        <h1 class="portal-title">AI Examination & Recruiter Bot</h1>
        <span class="role-badge">
          <i class="fa-solid fa-bolt text-warning"></i> Topic: <strong><%= candidate.examTopic || candidate.customBotPrompt || candidate.targetRole %></strong>
          &bull; <%= questions.length %> Questions &bull; <%= candidate.difficultyLevel || 'MID' %> Level
        </span>
      </div>
    </div>
    <div class="header-right">
      <div class="candidate-pill">
        <i class="fa-solid fa-user-circle"></i>
        <span><%= candidate.candidateName %></span>
      </div>
      <div class="timer-box" id="globalTimerContainer">
        <i class="fa-regular fa-clock"></i>
        <span id="questionTimer">02:00</span>
      </div>
    </div>
  </header>

  <!-- Security & Anti-Cheat Strip -->
  <div class="security-banner">
    <span><i class="fa-solid fa-shield-halved"></i> AI Proctored Exam &bull; Dynamic Questions generated by HR Prompt &bull; Hugging Face Semantic Evaluation</span>
    <span id="tabSwitchCounter" class="tab-warn">Tab switches: 0</span>
  </div>

  <!-- Main Exam Container -->
  <main class="exam-container">
    <div class="exam-card">
      <!-- Progress Bar -->
      <div class="progress-wrapper">
        <div class="progress-labels">
          <span id="progressStepText">Question 1 of <%= questions.length %></span>
          <span id="progressPercent">0%</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" id="progressBarFill" style="width: 20%;"></div>
        </div>
      </div>

      <!-- Quick Question Navigator Grid -->
      <div class="question-nav-grid mb-4" style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px dashed #e2e8f0;">
        <% questions.forEach((q, idx) => { %>
          <button type="button" class="q-jump-btn <%= idx === 0 ? 'active' : '' %>" data-jump="<%= idx %>" id="qJump_<%= idx %>" style="min-width: 40px; height: 40px; border-radius: 10px; border: 1.5px solid #cbd5e1; background: #ffffff; color: #475569; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; justify-content: center;">
            <%= idx + 1 %>
          </button>
        <% }); %>
      </div>

      <!-- Question Cards (Single page multi-step) -->
      <form id="examForm" action="/interview/<%= token %>/submit" method="POST">
        <% questions.forEach((q, index) => { %>
          <div class="question-step <%= index === 0 ? 'active' : '' %>" data-step="<%= index %>" data-limit="<%= q.timeLimitSeconds || 90 %>">
            <div class="question-meta">
              <span class="category-pill <%= q.category ? q.category.toLowerCase().replace(/\s+/g, '-') : 'general' %>">
                <i class="fa-solid fa-tag"></i> <%= q.category || 'Competency' %>
              </span>
              <span class="step-badge">Question <%= index + 1 %></span>
            </div>

            <h2 class="question-text"><%= q.questionText %></h2>

            <div class="input-wrapper">
              <label for="answer_<%= q.questionId %>" class="input-label">
                <span><i class="fa-solid fa-pen-nib"></i> Your Detailed Response</span>
                <span class="word-counter" id="wordCount_<%= q.questionId %>">0 words (min 20 recommended)</span>
              </label>
              <textarea 
                id="answer_<%= q.questionId %>" 
                name="answer_<%= q.questionId %>" 
                rows="7" 
                class="answer-textarea" 
                placeholder="Type your structured answer here. Include concrete examples, architecture decisions, and real-world outcomes..." 
                required
              ></textarea>
            </div>
          </div>
        <% }); %>

        <!-- Navigation Controls -->
        <div class="exam-controls">
          <button type="button" class="btn btn-secondary" id="prevBtn" disabled>
            <i class="fa-solid fa-arrow-left"></i> Previous
          </button>
          <div class="exam-notice">
            <i class="fa-solid fa-circle-info"></i> Answers are auto-evaluated by the HRMS AI assessment engine.
          </div>
          <button type="button" class="btn btn-primary" id="nextBtn">
            Next Question <i class="fa-solid fa-arrow-right"></i>
          </button>
          <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">
            <i class="fa-solid fa-check-circle"></i> Submit Assessment
          </button>
        </div>
      </form>
    </div>
  </main>

  <script src="/js/exam-timer.js"></script>
</body>
</html>
