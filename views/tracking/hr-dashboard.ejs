<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <title>Live Staff Tracking | HRMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- MapLibre GL CSS for OpenStreetMap 3D Interactive Tiles -->
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
    <style>
        body {
            background-color: #f7f9fc;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .sidebar {
            width: 350px;
            background: white;
            border-right: 1px solid #ddd;
            display: flex;
            flex-direction: column;
            z-index: 2;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
        }

        .map-wrapper {
            flex: 1;
            position: relative;
            z-index: 1;
        }

        #map {
            height: 100%;
            width: 100%;
        }

        .user-list {
            flex: 1;
            overflow-y: auto;
            padding: 0;
        }

        .user-item {
            padding: 15px 20px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            transition: all 0.2s;
        }

        .user-item:hover,
        .user-item.active {
            background-color: #f0f7ff;
            border-left: 4px solid #0d6efd;
        }

        .status-dot {
            height: 8px;
            width: 8px;
            background-color: #28a745;
            border-radius: 50%;
            display: inline-block;
        }

        .status-idle {
            background-color: #ffc107;
        }

        .status-offline {
            background-color: #dc3545;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-light bg-white border-bottom px-3 py-2">
        <a href="/hr/dashboard" class="btn btn-outline-dark rounded-circle me-3"><i
                class="fa-solid fa-arrow-left"></i></a>
        <span class="navbar-brand mb-0 h1 fw-bold">Live Fleet & Field Workforce Tracking</span>
    </nav>

    <!-- Main Content Area -->
    <div class="d-flex flex-grow-1 overflow-hidden">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="p-3 border-bottom">
                <input type="text" id="searchBox" class="form-control" placeholder="Search employee...">
            </div>

            <div class="user-list">
                <% trackedEmployees.forEach(emp=> { %>
                    <div class="user-item"
                        onclick="focusUser('<%= emp._id %>', <%= emp.lastKnownLocation ? emp.lastKnownLocation.lat : 0 %>, <%= emp.lastKnownLocation ? emp.lastKnownLocation.lng : 0 %>)">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3"
                                style="width: 40px; height: 40px; font-weight: bold;">
                                <%= emp.firstName.charAt(0) %>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 fw-bold">
                                    <%= emp.firstName %>
                                        <%= emp.lastName %>
                                </h6>
                                <small class="text-muted">
                                    <%= emp.department %> • <%= emp.designation %>
                                </small>
                                <div class="mt-1 small">
                                    <span class="status-dot status-active"></span>
                                    <span class="text-secondary">
                                        <%= new Date(emp.lastKnownLocation.timestamp).toLocaleTimeString([],
                                            {hour:'2-digit', minute:'2-digit'}) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% if(trackedEmployees.length===0) { %>
                            <div class="p-4 text-center text-muted">No location data available.</div>
                            <% } %>
            </div>
        </div>

        <!-- Map -->
        <div class="map-wrapper">
            <div id="map"></div>
        </div>
    </div>

    <!-- MapLibre GL JS for OpenStreetMap Interactive 3D Maps -->
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script>
        // Initialize MapLibre GL 3D Map
        const map = new maplibregl.Map({
            container: 'map',
            style: 'https://tiles.openfreemap.org/styles/liberty',
            center: [78.9629, 20.5937],
            zoom: 5,
            pitch: 50, // 3D perspective with extruded buildings
            bearing: -10,
            maxPitch: 85,
            dragRotate: true,
            pitchWithRotate: true,
            attributionControl: false
        });

        map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
        map.addControl(new maplibregl.AttributionControl({
            compact: true,
            customAttribution: '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
        }), 'bottom-right');

        const employees = <%- JSON.stringify(trackedEmployees) %>;
        const markers = {};
        const coordinates = [];

        map.on('load', () => {
            employees.forEach(emp => {
                if (emp.lastKnownLocation && emp.lastKnownLocation.lat) {
                    const lat = emp.lastKnownLocation.lat;
                    const lng = emp.lastKnownLocation.lng;
                    coordinates.push([lng, lat]);

                    const popup = new maplibregl.Popup({ offset: 25 }).setHTML(`
                        <b>${emp.firstName} ${emp.lastName}</b><br>
                        ${emp.designation} &bull; ${emp.department}<br>
                        <small class="text-muted">Updated: ${new Date(emp.lastKnownLocation.timestamp).toLocaleTimeString()}</small>
                    `);

                    const marker = new maplibregl.Marker({ color: '#0d6efd' })
                        .setLngLat([lng, lat])
                        .setPopup(popup)
                        .addTo(map);

                    markers[emp._id] = { marker, popup, lat, lng };
                }
            });

            // Fit bounds if employees exist
            if (coordinates.length > 0) {
                const bounds = coordinates.reduce((b, coord) => b.extend(coord), new maplibregl.LngLatBounds(coordinates[0], coordinates[0]));
                map.fitBounds(bounds, { padding: 60, maxZoom: 15 });
            }
        });

        function focusUser(id, lat, lng) {
            if (!lat || !lng) return;
            map.flyTo({ center: [lng, lat], zoom: 16, pitch: 50, bearing: -15, essential: true });
            if (markers[id] && markers[id].marker) {
                markers[id].marker.togglePopup();
            }

            // Highlight list item
            document.querySelectorAll('.user-item').forEach(el => el.classList.remove('active'));
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('active');
            }
        }

        // Search Filter
        document.getElementById('searchBox').addEventListener('keyup', function (e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.user-item').forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(term) ? 'block' : 'none';
            });
        });

    </script>
</body>

</html>