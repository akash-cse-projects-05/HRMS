                          <a href="tel:<%= c.phone %>" class="btn btn-outline-primary btn-sm rounded-circle me-1" title="Call Candidate: <%= c.phone %>">
                            <i class="fa-solid fa-phone"></i>
                          </a>
                        <% } %>
