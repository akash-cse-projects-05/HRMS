                            <button type="submit" class="btn btn-success btn-sm fw-bold px-2.5 rounded-3" title="1-Click Convert to Employee">
                              <i class="fa-solid fa-user-plus me-1"></i>Recruit
                            </button>
                          </form>
                        <% } else { %>
                          <span class="badge bg-secondary px-2.5 py-1.5 rounded-pill"><i class="fa-solid fa-check me-1"></i>Hired</span>
