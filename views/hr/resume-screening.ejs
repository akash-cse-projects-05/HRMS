                              <% if (c.extractedSkills && c.extractedSkills.length > 0) { %>
                                <% c.extractedSkills.forEach(s => { %>
                                  <span class="skill-tag skill-matched"><i class="fa-solid fa-check me-1"></i><%= s %></span>
                                <% }) %>
                              <% } else { %>
                                <span class="text-muted small">No specific matching skills extracted</span>
                              <% } %>
                            </div>

                            <% if (c.missingSkills && c.missingSkills.length > 0) { %>
