                            <i class="fa-solid fa-phone me-1"></i>Call Immediately
                          </span>
                        <% } else if (c.recommendation === 'SHORTLIST') { %>
                          <span class="badge badge-shortlist px-3 py-2 rounded-pill"><i class="fa-solid fa-thumbs-up me-1"></i>Shortlist</span>
                        <% } else if (c.recommendation === 'HOLD') { %>
                          <span class="badge badge-hold px-3 py-2 rounded-pill"><i class="fa-solid fa-pause me-1"></i>Hold</span>
                        <% } else { %>
                          <span class="badge badge-reject px-3 py-2 rounded-pill"><i class="fa-solid fa-xmark me-1"></i>Reject</span>
                        <% } %>
                      </td>
                      <td class="text-end">
