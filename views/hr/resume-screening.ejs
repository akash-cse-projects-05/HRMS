                                  <% } else { %>
                                    <span>N/A</span>
                                  <% } %> &nbsp;|&nbsp;
                                  <i class="fa-solid fa-phone me-1 text-primary"></i>
                                  <% if (c.phone) { %>
                                    <a href="tel:<%= c.phone %>" class="text-decoration-none fw-bold text-primary"><%= c.phone %></a>
                                  <% } else { %>
                                    <span>N/A</span>
                                  <% } %> &nbsp;|&nbsp;
                                  <i class="fa-solid fa-briefcase me-1 text-primary"></i>Experience: <%= c.yearsOfExperience %> Yrs
                                </p>
                                <div class="p-3 bg-white rounded-3 border small text-dark">
                                  <strong>AI Executive Summary:</strong> <%= c.aiSummary %>
                                </div>
                              </div>
                            </div>

                            <div class="mb-4">
