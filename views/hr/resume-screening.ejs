                                data-bs-toggle="modal" data-bs-target="#modal-bot-<%= c._id %>" title="AI Exam Studio">
                          <i class="fa-solid fa-robot me-1"></i>Exam Bot
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-circle me-1" 
                                data-bs-toggle="modal" data-bs-target="#modal-<%= c._id %>" title="Inspect Full Report">
