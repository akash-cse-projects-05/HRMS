                            </span>
                            <div class="d-flex align-items-center gap-1">
                              <a href="/interview/<%= c.interviewToken %>" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill fw-bold" style="font-size: 0.72rem;" title="Test Drive Live Exam">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Test Drive
                              </a>
                              <button type="button" class="btn btn-sm btn-light border py-0 px-2 rounded-pill fw-bold text-dark" style="font-size: 0.72rem;" onclick="copyInviteLink('<%= c.interviewToken %>')">
                                <i class="fa-regular fa-copy me-1 text-primary"></i>Copy
                              </button>
                            </div>
                          </div>
                        <% } else if (c.interviewStatus === 'IN_PROGRESS') { %>
