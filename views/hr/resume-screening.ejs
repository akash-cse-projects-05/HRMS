                          <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-2.5 py-1" style="font-size: 0.72rem;" data-bs-toggle="modal" data-bs-target="#modal-bot-<%= c._id %>">
                            <i class="fa-solid fa-wand-magic-sparkles me-1 text-primary"></i>Setup Exam
                          </button>
                        <% } %>
