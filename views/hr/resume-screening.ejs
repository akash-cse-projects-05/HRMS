                            <span class="badge bg-success text-white px-2.5 py-1 rounded-pill fw-bold"><i class="fa-solid fa-check-circle me-1"></i>Evaluated</span>
                            <a href="/hr/recruitment/<%= c._id %>/report" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill fw-bold" style="font-size: 0.72rem;">
                              <i class="fa-solid fa-chart-simple me-1"></i>Score: <%= c.aiAssessmentSummary?.overallScore || 0 %>%
                            </a>
                          </div>
