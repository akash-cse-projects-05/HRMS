                                    <option value="MID" <%= (!c.difficultyLevel || c.difficultyLevel === 'MID') ? 'selected' : '' %>>🟡 Mid-Level Specialist (3-5 yrs)</option>
                                    <option value="SENIOR" <%= c.difficultyLevel === 'SENIOR' ? 'selected' : '' %>>🔴 Senior / Lead Architect (6+ yrs)</option>
                                  </select>
