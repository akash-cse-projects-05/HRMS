                                <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-circle-xmark me-2"></i>Missing Target Criteria</h6>
                                <% c.missingSkills.forEach(s => { %>
                                  <span class="skill-tag skill-missing"><%= s %></span>
                                <% }) %>
                              </div>
                            <% } %>

                            <% if (c.strengths && c.strengths.length > 0) { %>
