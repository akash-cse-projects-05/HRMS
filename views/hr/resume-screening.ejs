          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>

        <form action="/hr/recruitment/create-exam-bot" method="POST">
          <div class="modal-body p-4 bg-light-subtle">
            <!-- Candidate Target Information -->
            <div class="p-3 bg-white rounded-3 border mb-3 shadow-xs">
              <span class="small text-muted fw-bold d-block mb-2 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                <i class="fa-solid fa-user-tag me-1 text-primary"></i>Candidate Information
              </span>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold small">Candidate Full Name <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                    <input type="text" name="candidateName" class="form-control" placeholder="e.g. Ramesh Kumar" required>
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold small">Email or WhatsApp Phone</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-paper-plane text-muted"></i></span>
                    <input type="text" name="email" class="form-control" placeholder="ramesh@example.com or +91...">
                  </div>
                </div>
              </div>
            </div>

            <!-- Subject Prompt Input -->
            <div class="mb-3">
              <label class="form-label fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-wand-magic-sparkles text-primary me-1.5"></i>Exam Subject / HR Bot Prompt <span class="text-danger">*</span></span>
                <span class="text-muted small" style="font-size: 0.75rem;">AI dynamically creates question pool</span>
              </label>
              <input type="text" name="prompt" id="instantPromptInput" class="form-control form-control-lg fw-semibold" 
                     placeholder="e.g. electronics, or circuit design, microcontrollers and embedded firmware" required>
              <div class="form-text small mt-1 text-muted">
                Specify any technical domain or job requirement (e.g. <em>"electronics"</em>, <em>"react node.js"</em>, <em>"embedded C"</em>, <em>"gst and balance sheet audit"</em>).
              </div>
            </div>

            <!-- Quick Presets Cards -->
            <div class="mb-4">
              <span class="small text-muted fw-bold d-block mb-2 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                Quick-Select Domain Presets:
              </span>
              <div class="row g-2">
                <div class="col-md-6 col-12">
                  <div class="topic-preset-card" 
                       onclick="document.getElementById('instantPromptInput').value='electronics, semiconductor physics, circuit design and PCB layout'; document.getElementById('instantQCount').value='5'; document.getElementById('instantRole').value='Electronics Engineer';">
                    <div class="topic-preset-icon bg-warning-subtle text-warning">
                      <i class="fa-solid fa-bolt"></i>
                    </div>
                    <div>
                      <strong class="d-block text-dark small">Electronics & Hardware</strong>
                      <span class="text-muted" style="font-size: 0.74rem;">Circuits, PCB, I2C/SPI, Microcontrollers (5Q)</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-12">
                  <div class="topic-preset-card" 
                       onclick="document.getElementById('instantPromptInput').value='embedded C, ARM Cortex, RTOS, device drivers and firmware'; document.getElementById('instantQCount').value='5'; document.getElementById('instantRole').value='Embedded Systems Engineer';">
                    <div class="topic-preset-icon bg-primary-subtle text-primary">
                      <i class="fa-solid fa-microchip"></i>
                    </div>
                    <div>
                      <strong class="d-block text-dark small">Embedded & Firmware</strong>
                      <span class="text-muted" style="font-size: 0.74rem;">C/C++, RTOS, Hardware Drivers, UART (5Q)</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-12">
                  <div class="topic-preset-card" 
                       onclick="document.getElementById('instantPromptInput').value='fullstack react, node.js, database optimization and microservices'; document.getElementById('instantQCount').value='5'; document.getElementById('instantRole').value='Full Stack Developer';">
                    <div class="topic-preset-icon bg-info-subtle text-info">
                      <i class="fa-solid fa-code"></i>
                    </div>
                    <div>
                      <strong class="d-block text-dark small">Full-Stack Web & Cloud</strong>
                      <span class="text-muted" style="font-size: 0.74rem;">React, Node, REST APIs, Microservices (5Q)</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-12">
                  <div class="topic-preset-card" 
                       onclick="document.getElementById('instantPromptInput').value='statutory tax, gst, tds, balance sheet auditing and corporate compliance'; document.getElementById('instantQCount').value='5'; document.getElementById('instantRole').value='Senior Accounts Manager';">
                    <div class="topic-preset-icon bg-success-subtle text-success">
                      <i class="fa-solid fa-receipt"></i>
                    </div>
                    <div>
                      <strong class="d-block text-dark small">Finance, Tax & Audit</strong>
                      <span class="text-muted" style="font-size: 0.74rem;">GST, TDS, P&L Audits, Statutory Filings (5Q)</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Target Designation</label>
                <input type="text" name="targetRole" id="instantRole" class="form-control fw-semibold" placeholder="e.g. Electronics Engineer">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Question Count</label>
                <select name="questionCount" id="instantQCount" class="form-select fw-semibold">
                  <option value="3">⚡ 3 Questions (10-Min Rapid)</option>
                  <option value="5" selected>⭐ 5 Questions (Standard Recommended)</option>
                  <option value="8">🔬 8 Questions (In-Depth Technical)</option>
                  <option value="10">🏆 10 Questions (Comprehensive Master)</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Difficulty Level</label>
                <select name="difficulty" class="form-select fw-semibold">
                  <option value="JUNIOR">🟢 Junior / Entry Level (1-2 yrs)</option>
                  <option value="MID" selected>🟡 Mid-Level Specialist (3-5 yrs)</option>
                  <option value="SENIOR">🔴 Senior / Lead Architect (6+ yrs)</option>
                </select>
              </div>
            </div>

            <!-- Proctoring & AI Evaluation Guarantee Banner -->
            <div class="proctoring-banner">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <span class="fw-bold small text-dark"><i class="fa-solid fa-shield-halved text-primary me-1.5"></i>Built-in Proctoring & AI Criteria:</span>
                <span class="badge bg-primary text-white" style="font-size: 0.65rem;">Hugging Face AI</span>
              </div>
              <div class="row g-2 text-muted small" style="font-size: 0.76rem;">
                <div class="col-4"><i class="fa-solid fa-clock me-1 text-primary"></i>90-120s per question</div>
                <div class="col-4"><i class="fa-solid fa-eye-slash me-1 text-danger"></i>Tab-switch tracking</div>
                <div class="col-4"><i class="fa-solid fa-chart-pie me-1 text-success"></i>Multi-metric scoring</div>
              </div>
            </div>
          </div>

          <div class="modal-footer bg-white border-top p-3 d-flex justify-content-between">
            <button type="button" class="btn btn-outline-secondary fw-bold rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary fw-bold px-4 py-2.5 rounded-pill shadow-sm text-white" style="background: linear-gradient(135deg, #0052cc 0%, #2563eb 100%); border: none;">
              <i class="fa-solid fa-wand-magic-sparkles me-1.5 text-warning"></i>Create AI Exam Bot & Generate 24h Link
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <footer class="text-center py-4 border-top bg-white mt-5">
    <p class="text-muted small mb-0">© 2026 HRMS • Enterprise AI Resume Screener & Talent Intelligence</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const dropZone = document.getElementById('resumeDropZone');
    const fileInput = document.getElementById('fileInput');
    const countEl = document.getElementById('fileCount');
    const listEl = document.getElementById('selectedFileList');

    if (dropZone) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.style.borderColor = '#0052cc';
          dropZone.style.background = '#e0f2fe';
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.style.borderColor = '#b3d4ff';
          dropZone.style.background = '#f8fafc';
        }, false);
      });

      dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          fileInput.files = dt.files;
          updateFileList(dt.files);
        }
      });
    }

    if (fileInput) {
      fileInput.addEventListener('change', function(e) {
        updateFileList(e.target.files);
      });
    }

    function updateFileList(files) {
      if (files && files.length > 0) {
        countEl.innerHTML = `<i class="fa-solid fa-circle-check me-1 text-primary"></i> ${files.length} resume file(s) selected for AI parsing`;
        let html = '<ul class="list-unstyled mb-0 mt-1">';
        for (let i = 0; i < Math.min(files.length, 5); i++) {
          html += `<li><i class="fa-regular fa-file-lines me-1 text-primary"></i>${files[i].name} <span class="text-muted">(${(files[i].size / 1024).toFixed(1)} KB)</span></li>`;
        }
        if (files.length > 5) {
          html += `<li class="text-primary fw-bold">+ and ${files.length - 5} more files</li>`;
        }
        html += '</ul>';
        listEl.innerHTML = html;
      } else {
        countEl.innerText = '';
        listEl.innerHTML = '';
      }
    }

    function filterCandidates() {
      const input = document.getElementById('candidateSearch').value.toLowerCase();
      const rows = document.querySelectorAll('.candidate-row');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
      });
    }

    function copyInviteLink(token) {
      if (!token) return;
      const url = `${window.location.origin}/interview/${token}`;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(() => {
          showToastNotification("✅ AI Exam Bot link copied to clipboard!");
        }).catch(() => {
          prompt("Copy this AI Exam Bot link:", url);
        });
      } else {
        prompt("Copy this AI Exam Bot link:", url);
      }
    }

    function showToastNotification(msg) {
      let toast = document.getElementById('hrmsToastNotification');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'hrmsToastNotification';
        toast.className = 'toast-copy-notification';
        document.body.appendChild(toast);
      }
      toast.innerHTML = `<i class="fa-solid fa-circle-check text-success fs-5"></i> <span>${msg}</span>`;
      toast.style.opacity = '1';
      setTimeout(() => {
        toast.style.opacity = '0';
      }, 3500);
    }
  </script>
</body>
</html>
