                                <i class="fa-solid fa-wand-magic-sparkles me-1.5 text-warning"></i>Generate AI Exam Bot & Link
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

        </div>
      </div>

    </div>

  </div>

