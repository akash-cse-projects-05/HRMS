<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Assessment Scorecard — <%= candidate.candidateName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/exam-portal.css">
  <link rel="stylesheet" href="/css/ai-workspace.css">
</head>
<body class="report-body">
  <!-- Top Navigation -->
  <header class="report-header">
    <div class="header-left">
      <a href="/hr/recruitment" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Back to Pipeline</a>
      <div>
        <h1 class="page-title">AI Evaluation Scorecard</h1>
        <p class="page-subtitle">Candidate: <strong><%= candidate.candidateName %></strong> &bull; Target: <strong><%= candidate.targetRole %></strong> &bull; Exam Bot Topic: <strong><span class="badge bg-primary text-white px-2 py-1"><i class="fa-solid fa-robot me-1"></i><%= candidate.examTopic || candidate.customBotPrompt || candidate.targetRole %></span></strong></p>
      </div>
    </div>
    <div class="header-actions">
      <% if (candidate.status === 'HIRED') { %>
        <span class="badge badge-hired"><i class="fa-solid fa-user-check"></i> Onboarded as Employee</span>
      <% } else { %>
        <form action="/hr/recruitment/<%= candidate._id %>/convert" method="POST" style="margin: 0;">
          <button type="submit" class="btn btn-convert" onclick="return confirm('Convert <%= candidate.candidateName %> directly to an active Employee account?');">
            <i class="fa-solid fa-wand-magic-sparkles"></i> 1-Click Convert to Employee
          </button>
        </form>
      <% } %>
      <button onclick="window.print()" class="btn btn-secondary">
        <i class="fa-solid fa-print"></i> Print Report
      </button>
    </div>
  </header>

  <main class="report-container">
    <!-- Candidate Header Card -->
    <div class="report-hero-card">
      <div class="hero-profile">
        <div class="avatar-box"><%= candidate.candidateName.charAt(0) %></div>
        <div class="profile-details">
          <h2><%= candidate.candidateName %></h2>
          <div class="profile-meta-row">
            <span><i class="fa-solid fa-envelope"></i> <%= candidate.email || 'N/A' %></span>
            <span><i class="fa-solid fa-phone"></i> <%= candidate.phone || 'N/A' %></span>
            <span><i class="fa-solid fa-building"></i> <%= candidate.department %></span>
            <span><i class="fa-solid fa-calendar"></i> Evaluated: <%= candidate.interviewCompletedAt ? new Date(candidate.interviewCompletedAt).toLocaleDateString() : 'Recent' %></span>
          </div>
        </div>
      </div>

      <div class="recommendation-badge-box">
        <% 
          const rec = (candidate.aiAssessmentSummary && candidate.aiAssessmentSummary.recommendation) || candidate.recommendation || 'HOLD';
          let recClass = 'rec-hold';
          let recIcon = 'fa-pause';
          if (rec === 'STRONG_HIRE') { recClass = 'rec-strong-hire'; recIcon = 'fa-circle-check'; }
          else if (rec === 'SHORTLIST') { recClass = 'rec-shortlist'; recIcon = 'fa-thumbs-up'; }
          else if (rec === 'REJECT') { recClass = 'rec-reject'; recIcon = 'fa-circle-xmark'; }
        %>
        <span class="rec-label">AI Hiring Recommendation</span>
        <div class="rec-badge <%= recClass %>">
          <i class="fa-solid <%= recIcon %>"></i> <%= rec.replace('_', ' ') %>
        </div>
      </div>
    </div>

    <!-- Metrics Score Grid -->
    <% const summary = candidate.aiAssessmentSummary || {}; %>
    <div class="score-cards-grid">
      <div class="score-card">
        <div class="score-card-header">
          <span>Overall Competency</span>
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <div class="score-number"><%= summary.overallScore || candidate.matchScore || 0 %>%</div>
        <div class="score-bar">
          <div class="score-bar-fill" style="width: <%= summary.overallScore || candidate.matchScore || 0 %>%;"></div>
        </div>
      </div>

      <div class="score-card">
        <div class="score-card-header">
          <span>Technical Mastery</span>
          <i class="fa-solid fa-code"></i>
        </div>
        <div class="score-number"><%= summary.technicalScore || 0 %>%</div>
        <div class="score-bar">
          <div class="score-bar-fill fill-blue" style="width: <%= summary.technicalScore || 0 %>%;"></div>
        </div>
      </div>

      <div class="score-card">
        <div class="score-card-header">
          <span>Problem Solving</span>
          <i class="fa-solid fa-puzzle-piece"></i>
        </div>
        <div class="score-number"><%= summary.problemSolvingScore || 0 %>%</div>
        <div class="score-bar">
          <div class="score-bar-fill fill-purple" style="width: <%= summary.problemSolvingScore || 0 %>%;"></div>
        </div>
      </div>

      <div class="score-card">
        <div class="score-card-header">
          <span>Communication</span>
          <i class="fa-solid fa-comments"></i>
        </div>
        <div class="score-number"><%= summary.communicationScore || 0 %>%</div>
        <div class="score-bar">
          <div class="score-bar-fill fill-green" style="width: <%= summary.communicationScore || 0 %>%;"></div>
        </div>
      </div>
    </div>

    <!-- Executive Summary Box -->
    <div class="section-card">
      <h3 class="section-title"><i class="fa-solid fa-brain"></i> Executive AI Summary & Observations</h3>
      <p class="summary-text"><%= summary.summaryNotes || candidate.aiSummary || 'Evaluation completed. Candidate demonstrated core role competencies.' %></p>

      <% if (candidate.extractedSkills && candidate.extractedSkills.length > 0) { %>
        <div class="skills-section">
          <h4><i class="fa-solid fa-tags"></i> Verified Resume Skills</h4>
          <div class="skill-tags">
            <% candidate.extractedSkills.forEach(s => { %>
              <span class="skill-tag skill-matched"><i class="fa-solid fa-check"></i> <%= s %></span>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Detailed Question Breakdown -->
    <div class="section-card">
      <h3 class="section-title"><i class="fa-solid fa-clipboard-question"></i> Detailed Candidate Responses & AI Scoring</h3>
      
      <% if (candidate.interviewQuestions && candidate.interviewQuestions.length > 0) { %>
        <div class="questions-accordion">
          <% candidate.interviewQuestions.forEach((q, i) => { %>
            <div class="question-row">
              <div class="q-header">
                <span class="q-index">#<%= i + 1 %> [<%= q.category || 'Technical' %>]</span>
                <span class="q-score"><i class="fa-solid fa-star"></i> AI Score: <%= q.aiScore || 0 %> / 10</span>
              </div>
              <div class="q-prompt"><%= q.questionText %></div>
              
              <div class="answer-box">
                <div class="box-label"><i class="fa-solid fa-user"></i> Candidate Answer:</div>
                <div class="answer-content"><%= q.candidateAnswer || '(No answer recorded)' %></div>
              </div>

              <% if (q.aiFeedback) { %>
                <div class="feedback-box">
                  <div class="box-label"><i class="fa-solid fa-robot"></i> AI Scorer Feedback:</div>
                  <div class="feedback-content"><%= q.aiFeedback %></div>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="empty-state">No structured interview questions have been submitted yet.</p>
      <% } %>
    </div>
  </main>
</body>
</html>
