<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Trip Route Audit | HRMS</title>

  <!-- Google Fonts & Bootstrap -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <!-- MapLibre GL CSS -->
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

  <style>
    :root {
      --hrms-blue-dark: #050c1e;
      --hrms-blue-glow: #020612;
      --hrms-electric: #38bdf8;
      --hrms-cyan: #06b6d4;
      --hrms-cobalt: #2563eb;
      --hrms-text-dark: #0f172a;
      --hrms-text-muted: #475569;
      --hrms-border: rgba(15, 23, 42, 0.08);
      --hrms-bg-light: #f8fafc;

      --btn-gradient: linear-gradient(135deg, #2563eb 0%, #0284c7 50%, #06b6d4 100%);
      --btn-gradient-hover: linear-gradient(135deg, #1d4ed8 0%, #0369a1 50%, #0891b2 100%);
    }

    body {
      background-color: var(--hrms-bg-light);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--hrms-text-dark);
      letter-spacing: -0.02em;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* --- BRANDING NAVBAR (Matching Landing Page) --- */
    .navbar-landing {
      background: rgba(255, 255, 255, 0.9) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--hrms-border);
      padding: 0.75rem 2rem;
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    .brand-emblem {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--hrms-cobalt) 0%, var(--hrms-cyan) 100%);
      border-radius: 8px;
      color: #ffffff;
      font-size: 0.95rem;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

    .brand-emblem i.fa-circle-nodes {
      font-size: 0.55rem;
      position: absolute;
      bottom: 4px;
      right: 4px;
      color: var(--hrms-electric);
      background: var(--hrms-blue-dark);
      border-radius: 50%;
      padding: 1px;
    }

    .navbar-brand {
      font-weight: 800;
      color: var(--hrms-blue-dark) !important;
      letter-spacing: -0.04em;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1.25rem;
      text-decoration: none;
    }

    .brand-accent {
      background: linear-gradient(to right, var(--hrms-cobalt), var(--hrms-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .btn-outline-nav {
      background: transparent;
      color: var(--hrms-cobalt);
      border: 1.5px solid var(--hrms-cobalt);
      padding: 6px 18px;
      border-radius: 99px;
      font-weight: 700;
      transition: all 0.2s ease;
      font-size: 0.85rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-outline-nav:hover {
      background: rgba(37, 99, 235, 0.05);
      color: var(--hrms-cobalt);
      transform: translateY(-1px);
    }

    .btn-primary-nav {
      background: var(--btn-gradient);
      color: #fff !important;
      border: none;
      padding: 7px 20px;
      border-radius: 99px;
      font-weight: 700;
      transition: all 0.2s ease;
      font-size: 0.85rem;
      text-decoration: none;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-primary-nav:hover {
      background: var(--btn-gradient-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.25);
    }

    /* Header Panel */
    .audit-header {
      background: #ffffff;
      border-bottom: 1px solid var(--hrms-border);
      padding: 18px 28px;
      margin-bottom: 22px;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.02);
    }

    .avatar-pill {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(37, 99, 235, 0.08);
      color: var(--hrms-cobalt);
      font-weight: 800;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .stat-pill-box {
      background: #ffffff;
      border: 1px solid var(--hrms-border);
      padding: 8px 18px;
      border-radius: 14px;
      text-align: center;
      min-width: 120px;
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.02);
    }

    .stat-pill-box .stat-val {
      font-weight: 800;
      font-size: 1.15rem;
      color: var(--hrms-cobalt);
      line-height: 1.2;
    }

    .stat-pill-box .stat-lbl {
      font-size: 0.7rem;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--hrms-text-muted);
    }

    /* Left Sidebar */
    .audit-sidebar {
      max-height: calc(100vh - 200px);
      overflow-y: auto;
      padding-right: 6px;
    }

    .audit-sidebar::-webkit-scrollbar {
      width: 5px;
    }

    .audit-sidebar::-webkit-scrollbar-thumb {
      background-color: #cbd5e1;
      border-radius: 3px;
    }

    /* Cards */
    .landing-card {
      background: #ffffff;
      border: 1px solid var(--hrms-border);
      border-radius: 20px;
      overflow: hidden;
      margin-bottom: 18px;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.02);
    }

    .landing-card-header {
      padding: 16px 20px;
      background: #ffffff;
      border-bottom: 1px solid var(--hrms-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .landing-card-body {
      padding: 18px 20px;
    }

    /* Map Canvas */
    #map {
      height: calc(100vh - 200px);
      width: 100%;
      border-radius: 20px;
      border: 1px solid var(--hrms-border);
      z-index: 1;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.02);
    }

    /* Blue Timeline */
    .timeline {
      position: relative;
      padding-left: 20px;
    }

    .timeline::before {
      content: '';
      position: absolute;
      top: 6px;
      bottom: 6px;
      left: 6px;
      width: 2px;
      background: rgba(37, 99, 235, 0.15);
    }

    .timeline-item {
      position: relative;
      margin-bottom: 14px;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: -20px;
      top: 5px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--hrms-cobalt);
      border: 2px solid #ffffff;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
    }

    .pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(37, 99, 235, 0.08);
      color: var(--hrms-cobalt);
      padding: 4px 12px;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .pill-badge-outline {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #ffffff;
      color: var(--hrms-text-muted);
      border: 1px solid var(--hrms-border);
      padding: 4px 12px;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 600;
    }
  </style>
</head>

<body>
  <%- include('../partials/anti-cache') %>

  <!-- Top Navigation (Exact Landing Page Brand Style) -->
  <nav class="navbar-landing d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <a class="navbar-brand" href="/hr/dashboard">
        <div class="brand-emblem">
          <i class="fa-solid fa-shield-halved"></i>
          <i class="fa-solid fa-circle-nodes"></i>
        </div>
        HR<span class="brand-accent">MS</span>
      </a>
      <span class="text-muted d-none d-md-inline" style="font-size: 0.9rem;">/</span>
      <a href="/trip/hr/dashboard" class="small fw-semibold text-secondary text-decoration-none d-none d-md-inline">
        Trip Management
      </a>
      <span class="text-muted d-none d-md-inline" style="font-size: 0.9rem;">/</span>
      <span class="small fw-semibold text-dark d-none d-md-inline">Route & Field Audit</span>
    </div>

    <div class="d-flex align-items-center gap-2">
      <a href="/trip/hr/dashboard" class="btn-outline-nav">
        <i class="fa-solid fa-arrow-left"></i> Back to Trips
      </a>
    </div>
  </nav>

  <!-- Trip Header Summary Banner -->
  <div class="audit-header">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="avatar-pill">
          <%= (trip.employeeId && trip.employeeId.firstName) ? trip.employeeId.firstName.charAt(0) : '?' %>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0 text-dark">
              <%= (trip.employeeId) ? trip.employeeId.firstName + ' ' + (trip.employeeId.lastName || '') : 'Unknown Personnel' %>
            </h4>
            <% if (trip.status === 'In Progress') { %>
              <span class="pill-badge">IN-TRANSIT</span>
            <% } else if (trip.status === 'Approved') { %>
              <span class="pill-badge">AUTHORIZED</span>
            <% } else if (trip.status === 'Completed') { %>
              <span class="pill-badge-outline">CONCLUDED</span>
            <% } else { %>
              <span class="pill-badge-outline"><%= trip.status.toUpperCase() %></span>
            <% } %>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-2 small text-muted mt-1">
            <span><%= (trip.employeeId && trip.employeeId.department) ? trip.employeeId.department : 'Operations' %></span>
            <span>&bull;</span>
            <span class="text-dark fw-semibold"><%= trip.source || 'Base' %> &rarr; <span style="color: var(--hrms-cobalt);"><%= trip.destination %></span></span>
            <span>&bull;</span>
            <span><%= new Date(trip.startDate).toLocaleDateString() %> &ndash; <%= new Date(trip.endDate).toLocaleDateString() %></span>
          </div>
        </div>
      </div>

      <!-- Telemetry Stats in Blue Theme -->
      <div class="d-flex flex-wrap gap-2">
        <div class="stat-pill-box">
          <div class="stat-val" id="dist-calc">Computing...</div>
          <div class="stat-lbl">Route Distance</div>
        </div>
        <div class="stat-pill-box">
          <div class="stat-val"><%= (trip.locations && trip.locations.length) ? trip.locations.length : 0 %></div>
          <div class="stat-lbl">Waypoints Logged</div>
        </div>
        <div class="stat-pill-box">
          <div class="stat-val"><%= (trip.dailyLogs && trip.dailyLogs.length) ? trip.dailyLogs.length : 0 %></div>
          <div class="stat-lbl">Daily Shifts</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Workspace Grid -->
  <div class="container-fluid px-lg-4 pb-4 flex-grow-1">
    <div class="row g-3">
      
      <!-- LEFT COLUMN: AUDIT TRAIL -->
      <div class="col-lg-5 col-xl-4">
        <div class="audit-sidebar">

          <!-- 1. Purpose -->
          <div class="landing-card">
            <div class="landing-card-header">
              <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                <i class="fa-solid fa-briefcase me-1" style="color: var(--hrms-cobalt);"></i> Purpose of Travel
              </span>
              <% if (trip.estimatedCost) { %>
                <span class="small fw-semibold text-dark">Budget: ₹<%= Number(trip.estimatedCost).toLocaleString('en-IN') %></span>
              <% } %>
            </div>
            <div class="landing-card-body">
              <p class="small text-secondary mb-0">
                <%= trip.purpose || 'No purpose recorded for this business travel.' %>
              </p>
            </div>
          </div>

          <!-- 2. Daily Shifts & Work Logged -->
          <div class="landing-card">
            <div class="landing-card-header">
              <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                <i class="fa-solid fa-clipboard-list me-1" style="color: var(--hrms-cobalt);"></i> Daily Work Records
              </span>
              <span class="pill-badge"><%= (trip.dailyLogs && trip.dailyLogs.length) ? trip.dailyLogs.length : 0 %> Shifts</span>
            </div>
            <div class="p-0">
              <% if (trip.dailyLogs && trip.dailyLogs.length > 0) { %>
                <div class="list-group list-group-flush">
                  <% trip.dailyLogs.forEach((log) => { %>
                    <div class="list-group-item p-3 border-bottom">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark small"><%= log.date %></span>
                        <span class="pill-badge-outline" style="font-size: 0.68rem;"><%= log.status %></span>
                      </div>

                      <div class="small text-muted mb-1">
                        <strong>Start:</strong> <%= log.startLocation ? (log.startLocation.address || 'Point Logged') : '-' %>
                        <% if (log.startTime) { %>
                          <span>(<%= new Date(log.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>)</span>
                        <% } %>
                      </div>

                      <div class="small text-muted mb-2">
                        <strong>End:</strong> <%= log.endLocation ? (log.endLocation.address || 'Point Logged') : '-' %>
                        <% if (log.endTime) { %>
                          <span>(<%= new Date(log.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>)</span>
                        <% } %>
                      </div>

                      <div class="p-2.5 bg-light rounded-3 small text-dark border">
                        <div class="d-flex justify-content-between align-items-start">
                          <span class="text-muted fw-semibold" style="font-size: 0.7rem; text-transform: uppercase;">Tasks Done:</span>
                          <% if (typeof isOwner !== 'undefined' && isOwner) { %>
                            <button class="btn btn-link btn-sm p-0 fw-semibold" style="font-size: 0.72rem; color: var(--hrms-cobalt);" onclick="editLog('<%= log._id %>', `<%= (log.tasksDone || '').replace(/`/g, '\\`') %>`)">
                              Edit
                            </button>
                          <% } %>
                        </div>
                        <div class="mt-0.5 text-secondary" id="desc-<%= log._id %>">
                          <%= log.tasksDone || 'No task description provided.' %>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="p-3 text-center text-muted small">
                  No daily work records logged yet.
                </div>
              <% } %>
            </div>
          </div>

          <!-- 3. Waypoint Timeline -->
          <div class="landing-card">
            <div class="landing-card-header">
              <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                <i class="fa-solid fa-route me-1" style="color: var(--hrms-cobalt);"></i> GPS Waypoints
              </span>
              <span class="pill-badge"><%= (trip.locations && trip.locations.length) ? trip.locations.length : 0 %></span>
            </div>
            <div class="landing-card-body">
              <% if (trip.locations && trip.locations.length > 0) { %>
                <div class="timeline">
                  <% trip.locations.slice(-8).reverse().forEach(l => { %>
                    <div class="timeline-item">
                      <div class="fw-bold text-dark small">
                        <%= l.type %>
                        <span class="text-muted fw-normal" style="font-size: 0.72rem;">
                          &bull; <%= new Date(l.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                        </span>
                      </div>
                      <% if (l.note) { %>
                        <div class="small text-secondary"><%= l.note %></div>
                      <% } %>
                      <div class="text-muted" style="font-size: 0.72rem;">
                        <code><%= Number(l.lat).toFixed(4) %>, <%= Number(l.lng).toFixed(4) %></code>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-center py-2 text-muted small">
                  No GPS waypoints recorded.
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: MAP -->
      <div class="col-lg-7 col-xl-8 position-relative">
        <div class="position-absolute top-0 start-0 m-3 p-1 bg-white rounded-pill shadow-sm border d-flex gap-1" style="z-index: 10;">
          <button type="button" class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fw-bold text-nowrap" id="styleBtn_bright" onclick="switchMapStyle('bright')">
            <i class="fa-solid fa-sun me-1"></i>Bright Clean
          </button>
          <button type="button" class="btn btn-sm btn-light rounded-pill px-2.5 py-1 fw-bold text-nowrap" id="styleBtn_positron" onclick="switchMapStyle('positron')">
            <i class="fa-solid fa-gem me-1 text-primary"></i>Positron Blue
          </button>
          <button type="button" class="btn btn-sm btn-light rounded-pill px-2.5 py-1 fw-bold text-nowrap" id="styleBtn_dark" onclick="switchMapStyle('dark')">
            <i class="fa-solid fa-moon me-1 text-dark"></i>Dark Mode
          </button>
          <button type="button" class="btn btn-sm btn-light rounded-pill px-2.5 py-1 fw-bold text-nowrap" id="styleBtn_liberty" onclick="switchMapStyle('liberty')">
            <i class="fa-solid fa-compass me-1 text-secondary"></i>Classic
          </button>
        </div>
        <div id="map"></div>
      </div>

    </div>
  </div>

  <!-- Edit Daily Log Modal -->
  <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4">
        <div class="modal-header border-bottom">
          <h6 class="modal-title fw-bold text-dark">Update Work Description</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <input type="hidden" id="editLogId">
          <label class="form-label small fw-semibold text-muted mb-1">Tasks Completed *</label>
          <textarea id="editTaskDesc" class="form-control rounded-3" rows="4" placeholder="Describe field work completed..." required></textarea>
        </div>
        <div class="modal-footer border-top bg-light py-2 px-4">
          <button type="button" class="btn-outline-nav btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn-primary-nav btn-sm" onclick="saveLog()">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const trip = <%- JSON.stringify(trip) %>;
    let currentMapStyle = 'bright';

    function switchMapStyle(styleName) {
      currentMapStyle = styleName;
      ['bright', 'positron', 'dark', 'liberty'].forEach(s => {
        const btn = document.getElementById('styleBtn_' + s);
        if (btn) {
          if (s === styleName) {
            btn.className = 'btn btn-sm btn-primary rounded-pill px-2.5 py-1 fw-bold text-nowrap';
          } else {
            btn.className = 'btn btn-sm btn-light rounded-pill px-2.5 py-1 fw-bold text-nowrap';
          }
        }
      });
      map.setStyle(`https://tiles.openfreemap.org/styles/${styleName}`);
    }

    // Initialize MapLibre GL Map (Clean Bright Style)
    const map = new maplibregl.Map({
      container: 'map',
      style: 'https://tiles.openfreemap.org/styles/liberty',
      center: [78.9629, 20.5937],
      zoom: 5,
      pitch: 50, // 3D perspective with extruded buildings
      bearing: -10,
      maxPitch: 85,
      dragRotate: true,
      pitchWithRotate: true,
      attributionControl: false
    });

    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
    map.addControl(new maplibregl.AttributionControl({
      compact: true,
      customAttribution: '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
    }), 'bottom-right');

    async function getCoords(place) {
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(place)}`);
        const data = await res.json();
        if (data && data.length > 0) {
          return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
        }
      } catch (e) {
        console.error("Geocoding failed for:", place, e);
      }
      return null;
    }

    function calculateDistanceKm(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return (R * c).toFixed(1);
    }

    map.on('load', async () => {
      const allCoords = [];

      // 1. Plot Tracked Route Path (Cobalt #2563eb)
      if (trip.locations && trip.locations.length > 0) {
        const routeCoordinates = trip.locations.map(l => [l.lng, l.lat]);
        routeCoordinates.forEach(c => allCoords.push(c));

        map.addSource('tracked-route', {
          type: 'geojson',
          data: {
            type: 'Feature',
            geometry: {
              type: 'LineString',
              coordinates: routeCoordinates
            }
          }
        });

        map.addLayer({
          id: 'tracked-route-line',
          type: 'line',
          source: 'tracked-route',
          layout: { 'line-join': 'round', 'line-cap': 'round' },
          paint: { 'line-color': '#2563eb', 'line-width': 4 }
        });

        // Add Markers for Major Waypoints in Cobalt
        trip.locations.forEach((l) => {
          if (l.type !== 'Ping' && l.type !== 'AutoArrival') {
            const popupText = `<strong>${l.type}</strong><br><small class="text-muted">${new Date(l.timestamp).toLocaleString()}</small>`;

            new maplibregl.Marker({ color: '#2563eb' })
              .setLngLat([l.lng, l.lat])
              .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(popupText))
              .addTo(map);
          }
        });
      }

      // 2. Geocode Source and Destination
      const srcCoords = await getCoords(trip.source);
      const destCoords = await getCoords(trip.destination);

      if (srcCoords && destCoords) {
        allCoords.push([srcCoords.lng, srcCoords.lat]);
        allCoords.push([destCoords.lng, destCoords.lat]);

        // Origin Marker (Cobalt)
        new maplibregl.Marker({ color: '#2563eb' })
          .setLngLat([srcCoords.lng, srcCoords.lat])
          .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(`<strong>Origin:</strong> ${trip.source}`))
          .addTo(map);

        // Destination Marker (Dark Blue)
        new maplibregl.Marker({ color: '#050c1e' })
          .setLngLat([destCoords.lng, destCoords.lat])
          .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(`<strong>Destination:</strong> ${trip.destination}`))
          .addTo(map);

        // Planned Route Dashed Line
        map.addSource('planned-route', {
          type: 'geojson',
          data: {
            type: 'Feature',
            geometry: {
              type: 'LineString',
              coordinates: [[srcCoords.lng, srcCoords.lat], [destCoords.lng, destCoords.lat]]
            }
          }
        });

        map.addLayer({
          id: 'planned-route-line',
          type: 'line',
          source: 'planned-route',
          paint: {
            'line-color': '#94a3b8',
            'line-width': 2,
            'line-dasharray': [3, 2]
          }
        });

        const distKm = calculateDistanceKm(srcCoords.lat, srcCoords.lng, destCoords.lat, destCoords.lng);
        document.getElementById('dist-calc').innerText = distKm + " km";
      } else {
        document.getElementById('dist-calc').innerText = "N/A";
      }

      if (allCoords.length > 0) {
        const bounds = allCoords.reduce((b, coord) => b.extend(coord), new maplibregl.LngLatBounds(allCoords[0], allCoords[0]));
        map.fitBounds(bounds, { padding: 50, maxZoom: 13 });
      }
    });

    const editModal = new bootstrap.Modal(document.getElementById('editModal'));

    function editLog(id, currentText) {
      document.getElementById('editLogId').value = id;
      document.getElementById('editTaskDesc').value = currentText;
      editModal.show();
    }

    async function saveLog() {
      const logId = document.getElementById('editLogId').value;
      const tasksDone = document.getElementById('editTaskDesc').value;

      try {
        const res = await fetch(`/trip/update-log/${trip._id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ logId, tasksDone })
        });
        const d = await res.json();
        if (d.success) {
          location.reload();
        } else {
          alert('Error updating log: ' + (d.error || 'Server error'));
        }
      } catch (e) {
        alert('Network communication error while updating log.');
      }
    }
  </script>
</body>

</html>