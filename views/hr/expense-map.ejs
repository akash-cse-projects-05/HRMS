<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <title>Expense Tracker & Field Claims | HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- MapLibre GL CSS for OpenStreetMap 3D Interactive Tiles -->
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

    <style>
        :root {
            --rsr-blue: #0052cc;
            --rsr-blue-hover: #0747a6;
            --rsr-text: #172b4d;
            --rsr-text-light: #626f86;
            --rsr-border: #dfe1e6;
            --rsr-bg: #f4f5f7;
            --rsr-card: #ffffff;
        }

        body {
            background-color: var(--rsr-bg);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--rsr-text);
            letter-spacing: -0.01em;
        }

        .navbar {
            background: #ffffff !important;
            border-bottom: 1px solid var(--rsr-border);
            padding: 0.85rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--rsr-blue) !important;
        }

        .page-header {
            padding: 24px 0 20px;
            border-bottom: 1px solid var(--rsr-border);
            background: #ffffff;
            margin-bottom: 20px;
        }

        .sidebar-list {
            height: calc(100vh - 195px);
            overflow-y: auto;
        }

        #map {
            height: calc(100vh - 195px);
            width: 100%;
            border-radius: 16px;
            border: 1px solid var(--rsr-border);
        }

        .expense-item {
            border-left: 4px solid transparent;
            transition: all 0.2s;
            cursor: pointer;
        }

        .expense-item:hover {
            background-color: #f4f8fe;
            border-left-color: var(--rsr-blue);
        }

        .avatar-small {
            width: 34px;
            height: 34px;
            background: #e9f2ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: bold;
            color: var(--rsr-blue);
        }
    </style>
</head>

<body>
    <%- include('../partials/anti-cache') %>

    <!-- Standard App Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="/hr/dashboard">
                <i class="fa-solid fa-building-shield me-2 text-primary"></i>
                <span>HRMS Control Center</span>
            </a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <a href="/hr/dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> HR Dashboard
                </a>
            </div>
        </div>
    </nav>

    <!-- Standard Page Header -->
    <div class="page-header">
        <div class="container-fluid px-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge mb-1" style="background: rgba(0, 82, 204, 0.1); color: var(--rsr-blue); border: 1px solid rgba(0, 82, 204, 0.2); font-weight: 700; font-size: 0.72rem;">
                        <i class="fa-solid fa-receipt me-1"></i> FIELD EXPENSE AUDIT & GEOTRACKING
                    </span>
                    <h3 class="fw-bold mb-0" style="color: #091e42; letter-spacing: -0.02em;">Expense Tracker & Geotagged Claims</h3>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> <%= pendingExpenses.length %> Claims Pending Review
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4">
        <div class="row g-3">

            <!-- Left Sidebar: Pending Lists -->
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-warning"></i> Pending Approvals
                    </div>
                    <div class="list-group list-group-flush sidebar-list">
                        <% if(pendingExpenses.length===0) { %>
                            <div class="p-4 text-center text-muted">No pending claims.</div>
                            <% } %>
                                <% pendingExpenses.forEach(exp=> { %>
                                    <div class="list-group-item expense-item p-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-small me-2">
                                                    <%= exp.employeeId.firstName.charAt(0) %>
                                                </div>
                                                <div>
                                                    <div class="fw-bold small">
                                                        <%= exp.employeeId.firstName %>
                                                            <%= exp.employeeId.lastName %>
                                                    </div>
                                                    <div class="text-muted" style="font-size: 11px;">
                                                        <%= exp.type %>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="fw-bold text-dark">₹<%= exp.amount %>
                                            </div>
                                        </div>
                                        <p class="small text-secondary mb-2 fst-italic">"<%= exp.description %>"</p>

                                        <div class="d-flex gap-2 mt-2">
                                            <% if(exp.receiptPath) { %>
                                                <a href="<%= exp.receiptPath %>" target="_blank"
                                                    class="btn btn-sm btn-outline-secondary py-0"
                                                    style="font-size: 11px;">Receipt</a>
                                                <% } %>
                                                    <form action="/expense/hr/action/<%= exp._id %>" method="POST"
                                                        class="d-flex gap-1 ms-auto">
                                                        <input type="hidden" name="status" value="Approved">
                                                        <button class="btn btn-sm btn-success py-0"
                                                            style="font-size: 11px;">Approve</button>
                                                    </form>
                                                    <button onclick="reject('<%= exp._id %>')"
                                                        class="btn btn-sm btn-danger py-0"
                                                        style="font-size: 11px;">Reject</button>
                                        </div>
                                        <!-- Hidden reject form -->
                                        <form id="reject-form-<%= exp._id %>" action="/expense/hr/action/<%= exp._id %>"
                                            method="POST" class="mt-2 d-none">
                                            <input type="hidden" name="status" value="Rejected">
                                            <div class="input-group input-group-sm">
                                                <input type="text" name="reason" class="form-control"
                                                    placeholder="Reason..." required>
                                                <button class="btn btn-danger">Confirm</button>
                                            </div>
                                        </form>
                                    </div>
                                    <% }) %>
                    </div>
                </div>
            </div>

            <!-- Right: Map -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-3">
                    <div class="card-body p-0">
                        <div id="map"></div>
                    </div>
                    <div class="card-footer bg-white small text-muted">
                        <i class="fa-solid fa-info-circle me-1"></i> Showing last known locations of field staff
                        (Checked-in within last 24h).
                    </div>
                </div>

                <!-- Employee Selector -->
                <div class="card shadow-sm p-3">
                    <h6 class="fw-bold mb-3">Active Field Agents</h6>
                    <div class="d-flex gap-3 overflow-auto pb-2">
                        <% employeesOnMap.forEach(emp=> { %>
                            <div class="border rounded p-2 d-flex align-items-center bg-white"
                                style="min-width: 200px; cursor: pointer;"
                                onclick="focusMap('<%= emp.lastKnownLocation.lat %>', '<%= emp.lastKnownLocation.lng %>')">
                                <div class="avatar-small me-2">
                                    <%= emp.firstName.charAt(0) %>
                                </div>
                                <div>
                                    <div class="fw-bold small">
                                        <%= emp.firstName %>
                                    </div>
                                    <div class="text-muted" style="font-size: 10px;">
                                        <%= emp.lastKnownLocation.timestamp ? new
                                            Date(emp.lastKnownLocation.timestamp).toLocaleTimeString() : 'Unknown' %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MapLibre GL JS for OpenStreetMap Interactive 3D Maps -->
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

    <script>
        // Initialize MapLibre GL 3D Map
        const map = new maplibregl.Map({
            container: 'map',
            style: 'https://tiles.openfreemap.org/styles/liberty',
            center: [78.9629, 20.5937], // India Centered [lng, lat]
            zoom: 5,
            pitch: 50, // 3D perspective with extruded buildings
            bearing: -10,
            maxPitch: 85,
            dragRotate: true,
            pitchWithRotate: true,
            attributionControl: false
        });

        map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
        map.addControl(new maplibregl.AttributionControl({
            compact: true,
            customAttribution: '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
        }), 'bottom-right');

        // Add Markers from Server Data
        const employees = <%- JSON.stringify(employeesOnMap) %>;
        const employeeMarkers = {};
        const coordinates = [];

        map.on('load', () => {
            employees.forEach(emp => {
                if (emp.lastKnownLocation && emp.lastKnownLocation.lat) {
                    const lat = emp.lastKnownLocation.lat;
                    const lng = emp.lastKnownLocation.lng;
                    coordinates.push([lng, lat]);

                    const popup = new maplibregl.Popup({ offset: 25 }).setHTML(`
                        <b>${emp.firstName} ${emp.lastName}</b><br>
                        ${emp.designation}<br>
                        <small class="text-muted">${new Date(emp.lastKnownLocation.timestamp).toLocaleString()}</small>
                    `);

                    const marker = new maplibregl.Marker({ color: '#0052cc' })
                        .setLngLat([lng, lat])
                        .setPopup(popup)
                        .addTo(map);

                    employeeMarkers[`${lat}_${lng}`] = marker;
                }
            });

            if (coordinates.length > 0) {
                const bounds = coordinates.reduce((b, coord) => b.extend(coord), new maplibregl.LngLatBounds(coordinates[0], coordinates[0]));
                map.fitBounds(bounds, { padding: 60, maxZoom: 14 });
            }
        });

        function focusMap(lat, lng) {
            if (lat && lng) {
                map.flyTo({ center: [parseFloat(lng), parseFloat(lat)], zoom: 15, pitch: 50, essential: true });
                const m = employeeMarkers[`${lat}_${lng}`];
                if (m) m.togglePopup();
            }
        }

        function reject(id) {
            const form = document.getElementById('reject-form-' + id);
            form.classList.toggle('d-none');
        }
    </script>

    <%- include('../partials/ai-floating-assistant') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>