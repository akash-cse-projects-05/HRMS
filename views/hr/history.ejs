<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance History & Summary | HRMS</title>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    :root {
      --rsr-blue: #0052cc;
      --rsr-blue-hover: #0747a6;
      --rsr-text: #172b4d;
      --rsr-text-light: #626f86;
      --rsr-border: #dfe1e6;
      --rsr-bg: #f4f5f7;
      --rsr-card: #ffffff;
      --rsr-light: #f7f9fc;
      --rsr-success: #00875a;
    }

    body {
      background-color: var(--rsr-bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--rsr-text);
      letter-spacing: -0.01em;
    }

    /* Standard App Navbar */
    .navbar {
      background: #ffffff !important;
      border-bottom: 1px solid var(--rsr-border);
      padding: 0.85rem 0;
    }

    .navbar-brand {
      font-weight: 800;
      color: var(--rsr-blue) !important;
    }

    /* Page Header */
    .page-header {
      padding: 35px 0 25px;
      border-bottom: 1px solid var(--rsr-border);
      margin-bottom: 30px;
      background: #ffffff;
    }

    /* Container for Data Table */
    .data-container {
      border: 1px solid var(--rsr-border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(9, 30, 66, 0.04);
      background: #ffffff;
    }

    .card-filter-bar {
      padding: 16px 24px;
      background: #ffffff;
      border-bottom: 1px solid var(--rsr-border);
    }

    .table {
      margin-bottom: 0;
    }

    .table thead th {
      background-color: var(--rsr-light);
      padding: 16px 24px;
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--rsr-text-light);
      border-bottom: 1px solid var(--rsr-border);
    }

    .table tbody td {
      padding: 18px 24px;
      vertical-align: middle;
      border-bottom: 1px solid var(--rsr-border);
      font-size: 0.9rem;
    }

    .table tbody tr:hover {
      background-color: #f8fafc;
    }

    .employee-code-badge {
      font-family: 'SFMono-Regular', Menlo, Monaco, Consolas, monospace;
      background: #f1f2f4;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.82rem;
      color: #44546f;
      font-weight: 600;
      border: 1px solid #dfe1e6;
    }

    .badge-present {
      background: #e3fcef;
      color: #006644;
      padding: 5px 12px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.78rem;
      border: 1px solid #abf5d1;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .avatar-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #e9f2ff;
      color: var(--rsr-blue);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.85rem;
    }
  </style>
</head>

<body>
  <%- include('../partials/anti-cache') %>

  <!-- Standard App Navbar -->
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center" href="/hr/dashboard">
        <i class="fa-solid fa-building-shield me-2 text-primary"></i>
        <span>HRMS Control Center</span>
      </a>
      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/hr/dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="fa-solid fa-arrow-left me-1"></i> HR Dashboard
        </a>
      </div>
    </div>
  </nav>

  <!-- Standard Page Header -->
  <div class="page-header">
    <div class="container-fluid px-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <span class="badge mb-2" style="background: rgba(0, 82, 204, 0.1); color: var(--rsr-blue); border: 1px solid rgba(0, 82, 204, 0.2); font-weight: 700; font-size: 0.72rem;">
            <i class="fa-solid fa-calendar-days me-1"></i> ATTENDANCE AUDIT & METRICS
          </span>
          <h2 class="fw-bold mb-1" style="color: #091e42; letter-spacing: -0.02em;">Attendance Summary & History</h2>
          <p class="text-muted mb-0" style="font-size: 0.88rem;">Review employee presence logs, cumulative attendance scores, and export audit sheets.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button onclick="exportExcel()" class="btn btn-outline-success rounded-pill px-3 fw-bold btn-sm shadow-sm">
            <i class="fa-solid fa-file-excel me-1"></i> Export Excel
          </button>
          <button onclick="exportWord()" class="btn btn-outline-primary rounded-pill px-3 fw-bold btn-sm shadow-sm">
            <i class="fa-solid fa-file-word me-1"></i> Export Word
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="container-fluid px-4 mb-5">
    <div class="data-container">
      <!-- Search Filter Bar -->
      <div class="card-filter-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
        <form action="/hr/attendance-history" method="GET" class="d-flex gap-2 align-items-center" style="max-width: 420px; width: 100%;">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" name="search" class="form-control border-start-0" placeholder="Search by name or employee code..."
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button type="submit" class="btn btn-primary px-3 fw-bold">Search</button>
          </div>
          <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <a href="/hr/attendance-history" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-nowrap" title="Clear Search">
              <i class="fa-solid fa-xmark me-1"></i> Clear
            </a>
          <% } %>
        </form>

        <span class="text-muted small fw-semibold">
          Total Employees Tracked: <strong class="text-dark"><%= (attendanceStats || []).length %></strong>
        </span>
      </div>

      <!-- Table Content -->
      <div class="table-responsive">
        <% if (!attendanceStats || attendanceStats.length === 0) { %>
          <div class="text-center py-5">
            <div class="mb-3 text-muted" style="font-size: 2.5rem;"><i class="fa-regular fa-calendar-xmark"></i></div>
            <h5 class="fw-bold text-dark">No Attendance Records Found</h5>
            <p class="text-muted small">No attendance punch records found for the requested search query.</p>
          </div>
        <% } else { %>
          <table id="attendanceTable" class="table align-middle">
            <thead>
              <tr>
                <th style="width: 200px;">Employee Code</th>
                <th>Employee Name</th>
                <th style="width: 250px;">Total Present Days</th>
                <th style="width: 140px;" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% attendanceStats.forEach(stat => { %>
                <tr>
                  <td>
                    <span class="employee-code-badge">
                      <i class="fa-solid fa-hashtag me-1 opacity-50"></i><%= stat.employeeCode %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-3">
                      <div class="avatar-circle">
                        <%= (stat.name || 'E').charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <strong class="d-block" style="color: #091e42; font-size: 0.95rem;"><%= stat.name %></strong>
                        <small class="text-muted" style="font-size: 0.78rem;">Full-Time Active</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge-present">
                      <i class="fa-solid fa-circle-check"></i>
                      <%= stat.presentDays %> Days Present
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/hr/attendance-history?search=<%= encodeURIComponent(stat.employeeCode) %>" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5" title="Filter Records">
                      <i class="fa-solid fa-filter me-1"></i> Focus
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('../partials/ai-floating-assistant') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // EXPORT EXCEL
    function exportExcel() {
      const table = document.getElementById("attendanceTable");
      if (!table) return alert("No attendance records to export.");
      const html = table.outerHTML;
      const css = `
        <style>
          table { border-collapse: collapse; font-family: sans-serif; }
          th { background-color: #0052cc; color: #ffffff; border: 1px solid #dfe1e6; padding: 10px; font-weight: bold; }
          td { border: 1px solid #dfe1e6; padding: 8px 10px; }
        </style>
      `;
      const template = `<html><head><meta charset="UTF-8">${css}</head><body><h2>HRMS Attendance Summary</h2>${html}</body></html>`;
      const blob = new Blob([template], { type: "application/vnd.ms-excel" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `HRMS_Attendance_Summary_${new Date().toISOString().split('T')[0]}.xls`;
      link.click();
    }

    // EXPORT WORD
    function exportWord() {
      const table = document.getElementById("attendanceTable");
      if (!table) return alert("No attendance records to export.");
      const html = table.outerHTML;
      const date = new Date().toLocaleDateString();
      const content = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word'>
        <head><meta charset="UTF-8"><style>
          body { font-family: Arial, sans-serif; }
          table { border-collapse: collapse; width: 100%; }
          th { background-color: #0052cc; color: white; padding: 10px; border: 1px solid black; font-weight: bold; }
          td { padding: 8px 10px; border: 1px solid black; }
        </style></head>
        <body>
          <h2 style="color: #0052cc; text-align: center;">HRMS Attendance Summary Audit</h2>
          <p style="text-align: center; color: #666;">Generated on: ${date}</p>
          ${html}
        </body></html>`;
      const blob = new Blob([content], { type: "application/msword" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `HRMS_Attendance_Summary_${date.replace(/\//g, '-')}.doc`;
      link.click();
    }
  </script>
</body>

</html>